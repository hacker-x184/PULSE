  view_file {
    absolute_path_uri: "file:///src/components/projects/ProjectsPage.tsx"
    start_line: 219
    end_line: 299
    content: "              onClick={handleOpenCreate}\n              className=\"mt-4 px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors\"\n            >\n              + Create First Project\n            </button>\n          )}\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {filteredProjects.map(p => {\n            const pTasks = tasks.filter(t => t.project_id === p.id);\n            const totalTasks = pTasks.length;\n            const completedTasks = pTasks.filter(t => t.status === \'Done\').length;\n            const progressPct = totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;\n            const memberCount = (p.member_ids || []).length;\n\n            return (\n              <div\n                key={p.id}\n                className=\"bg-white rounded-xl border border-slate-200 hover:border-slate-300 p-5 shadow-2xs flex flex-col justify-between transition-all\"\n              >\n                <div>\n                  {/* Top line: status badge and actions */}\n                  <div className=\"flex items-start justify-between gap-3 mb-2\">\n                    <span\n                      className={`text-[11px] font-semibold px-2 py-0.5 rounded font-mono ${\n                        p.status === \'Active\'\n                          ? \'bg-blue-50 text-blue-700 border border-blue-200\'\n                          : p.status === \'Completed\'\n                          ? \'bg-emerald-50 text-emerald-700 border border-emerald-200\'\n                          : p.status === \'In Review\'\n                          ? \'bg-amber-50 text-amber-700 border border-amber-200\'\n                          : \'bg-slate-100 text-slate-600 border border-slate-200\'\n                      }`}\n                    >\n                      {p.status}\n                    </span>\n\n                    <div className=\"flex items-center gap-1\">\n                      <button\n                        type=\"button\"\n                        onClick={() => handleOpenEdit(p)}\n                        aria-label={`Edit ${p.name}`}\n                        className=\"p-1 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded transition-colors\"\n                      >\n                        <Edit2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        type=\"button\"\n                        onClick={() => setDeletingProjectId(p.id)}\n                        aria-label={`Delete ${p.name}`}\n                        className=\"p-1 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Project Title & Description */}\n                  <h3 className=\"text-sm font-bold text-slate-900 line-clamp-1\">\n                    {p.name}\n                  </h3>\n                  <p className=\"text-xs text-slate-500 mt-1 line-clamp-2 min-h-[32px]\">\n                    {p.description || \'No description provided.\'}\n                  </p>\n\n                  {/* Progress bar */}\n                  <div className=\"mt-4\">\n                    <div className=\"flex items-center justify-between text-xs mb-1\">\n                      <span className=\"text-slate-500\">Progress</span>\n                      <span className=\"font-semibold text-slate-800 font-mono\">\n                        {completedTasks}/{totalTasks} ({progressPct}%)\n                      </span>\n                    </div>\n                    <div className=\"w-full bg-slate-100 rounded-full h-1.5 overflow-hidden\">\n                      <div\n                        className=\"bg-blue-600 h-1.5 rounded-full transition-all duration-300\"\n                        style={{ width: `${progressPct}%` }}\n                      />\n                    </div>\n                  </div>"
