      thinking_signature: "\022\264\b\n\261\b\001i\024}\023\360\220m\226\314+b\203d\337\320U\300D\254\334;\177\322|\331!\354\213?0\266I\316\243\334\247!0\265\234\023\241C\330\277\326\375\364\362/\315\327\021\357\023L\022\033\0361\302\v]\217\243\317\202\230\255\311\354\373;\350Z\033\204+\017\371O\326,\2434\326\230\2510\323\322\246y\264\326\316\2762\272D\2616\321\302I\370=\231\363E\240=\251\025\332\247\223\357\256q\365\220ck\037\237e\177^\346l:\335M\370\241W\314\000\032k\221z\367\334\260[N\372U\307,\033V\371wf$\n\350\370h\210\005\344$\307z\377\033\311-Q}\253\342;\216k\f\355$\002x\211\rxp2n\316\a\205q\370\320\374\231\336\265\a>\221_\370\255\342\273^rr\016S3<\341(\250\033\363 DK\245&|\336j\200z!u\274G\312\303\232\364s\267Od\2618y\0300\"{\236\225\033\366\363\222\304\030Y\271\214N\311\272\006\317\350\357\262\301\312Z\241\266\360\323\345\341>\240)\314\217\350^`\000{\204\000\017j4\341Q\025#\035\350\302 \t\005\230\200\311\363\300\202\201\270V2Q\371\257\377l\242\323\332\005\244I\302\2139\310\203_\v\232\366\026h+\2155\265\234\350\313\005\006?\244\211\r.\n\205F\371T\354\303\ne\254\201\332v\207i=\223&.O\023\323w\253\021\244\327\006D\214\210\030t\213\366\2217\f\241\313*pf\r:p\363d\226\0066\250\271\375\035\030\366ba\031\005\b\b=#g\246gV\037\376dS&\253\237\320\264\211\337\004\200\212\351\022Z$\276R\2320\3559\210\367\316\032\022\343\213\3415\000\036\220y\232\351$\254\271\033\234\022T\253\240\240G\232\214r\361f&\267\n\252\002\267YhV\266\330\177\344Y|\273&\361\036+\347\301\314\356\204P\343\345\272\235W\377\314\001\365\254\354\202\2139v/F\003\317\202\300@\236f\216z3\375\350\266\373\366\361\b\276\204\021N\\\341\214\303F\004g\273\321\002\244\374%r\236cw;2\264sb\305S\207\300\2253Ol\376/\233{\250\324N\3068,\212^\367\231@4\016\321\237\355!{\305\017\225\n\021:H&u\235\346\313\310p\321\330\242\247\2105\345\220f\307O4<]\242\301r\374\372\303T\211\262\211\242K\221\241\302\237\332q\337\222\027{\340[\325\2360\353,Q\314\242b\311\330L\003C\vc\217\233\372n\210\350\n\214\327\252\304G\023}\323Q\264g\335\026<n\'=\3235\374f?\266\251_\b\206X\300\250\325%\323\373\f1\241\231=\272\020\223\035X\344eO\235\006bEYj\232(\021Q\323\357P\226\356\255\340\271\217\206\r0\357\r_\377\213\373\323\332\221\256a\325\002a\330\016\204]@o\223\030\032\303\037\242\031J\367 B\215|\001\220k?\264\274\262\272\006\215\246\303\030\36320\032\307\367\273\214\235D\320\ro1\256\377\253Q\0223\215H\3418\217\006E\3551\222\033S\262L\']\264\246\365&\320\v\031\333dF\0304(\n\252\210\367\266\232\274\347\216\366\235\'Np\304E!#\316\245\021\264\234\030\277k\266\335Jx\247) \256\274\200\022ps>\244mP\2508\b$\365\304\223\001\025\220d<Q\001\3550\313\303\361,\340\225\367\034\n\233Z\365\036\212\367-9\2765\310\325J\3605\264YW\235\235d\270\353ga\253\t\031-\363\356\al\026A\331\246p\363-\216\a-\266\322\357c6t\324\345\001<\274\022\253\217\271s\263\235`\227fG\036\204\347\350\256T\340H\255\212%nm\032\250\300\357K\017+Qe\027|\275\327rS\375T\002\276F\300\035\177\311\266\236yr4klQW\003\246,\022\264\361\3040\232\022X\327\2441\257\253[\215\202\356\235\344i\212\216\340\304\261\236\022\b\362\026C\321\367\323\320R\361\024\026\246\326\024\037#[\372,p\220\226Y\343~\355\343\217\270\232F$jvC"
