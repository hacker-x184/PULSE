    content: "                  </div>\n\n                  {/* Metadata: Deadline & Members */}\n                  <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500\">\n                    <div className=\"flex items-center gap-1.5\">\n                      <Calendar className=\"w-3.5 h-3.5 text-slate-400\" />\n                      <span className=\"font-mono\">\n                        {p.deadline ? `Due ${p.deadline}` : \'No deadline\'}\n                      </span>\n                    </div>\n                    <div className=\"flex items-center gap-1.5\">\n                      <Users className=\"w-3.5 h-3.5 text-slate-400\" />\n                      <span>{memberCount} member{memberCount !== 1 ? \'s\' : \'\'}</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Bottom CTA: Go to Task Board */}\n                <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      onSelectProject(p.id);\n                      onNavigateToTasks(p.id);\n                    }}\n                    className=\"w-full py-1.5 px-3 text-xs font-semibold text-blue-700 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 rounded-lg transition-colors flex items-center justify-center gap-1.5\"\n                  >\n                    <span>Inspect Tasks</span>\n                    <ExternalLink className=\"w-3 h-3\" />\n                  </button>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      )}\n\n      {/* Create / Edit Project Modal */}\n      <Modal\n        isOpen={isCreateOpen || editingProject !== null}\n        onClose={() => {\n          setIsCreateOpen(false);\n          setEditingProject(null);\n          resetForm();\n        }}\n        title={editingProject ? \'Edit Project Milestone\' : \'Create New Project\'}\n        subtitle=\"Specify project scope, milestone timelines, and assign team resources.\"\n      >\n        <form onSubmit={handleSaveProject} className=\"space-y-4\">\n          {formError && (\n            <div className=\"p-3 text-xs text-rose-700 bg-rose-50 border border-rose-200 rounded-lg flex items-center gap-2\">\n              <AlertCircle className=\"w-4 h-4 shrink-0\" />\n              <span>{formError}</span>\n            </div>\n          )}\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n              Project Name *\n            </label>\n            <input"
