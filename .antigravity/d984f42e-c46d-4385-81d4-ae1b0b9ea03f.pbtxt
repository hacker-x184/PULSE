  view_file {
    absolute_path_uri: "file:///src/types/index.ts"
    end_line: 99
    content: "export type ProjectStatus = \'Planning\' | \'Active\' | \'In Review\' | \'Completed\' | \'On Hold\';\nexport type TaskStatus = \'To Do\' | \'In Progress\' | \'In Review\' | \'Done\';\nexport type TaskPriority = \'Low\' | \'Medium\' | \'High\';\nexport type RiskLevel = \'Low\' | \'Medium\' | \'High\';\nexport type IssueType = \'Story\' | \'Bug\' | \'Task\' | \'Epic\';\nexport type ProjectRole = \'Project Leader\' | \'Tech Lead\' | \'Senior Developer\' | \'QA Engineer\' | \'Product Designer\';\nexport type SystemRole = \'Admin\' | \'Manager\' | \'Member\';\n\nexport interface ProjectMemberDetail {\n  member_id: string;\n  role: ProjectRole | string;\n  name?: string;\n  email?: string;\n  avatar_url?: string;\n  github_username?: string;\n}\n\nexport interface Project {\n  id: string;\n  name: string;\n  description?: string;\n  objectives?: string;\n  start_date?: string;\n  deadline?: string;\n  status: ProjectStatus;\n  leader_id?: string;\n  leader_name?: string;\n  key_prefix?: string;\n  current_sprint?: string;\n  is_archived?: boolean;\n  member_ids?: string[];\n  members?: ProjectMemberDetail[];\n  created_at?: string;\n  updated_at?: string;\n}\n\nexport interface User {\n  id: string;\n  name: string;\n  email: string;\n  role: SystemRole | string;\n  avatar_url?: string;\n  created_at?: string;\n  github_username?: string;\n}\n\nexport interface LinkedCommit {\n  sha: string;\n  message: string;\n  author_login: string;\n  date?: string;\n  url?: string;\n  branch?: string;\n}\n\nexport interface Subtask {\n  id: string;\n  task_id: string;\n  title: string;\n  is_completed: boolean;\n  created_at?: string;\n}\n\nexport interface AcceptanceCriterion {\n  id: string;\n  task_id: string;\n  criterion: string;\n  is_met: boolean;\n  created_at?: string;\n}\n\nexport interface TaskReview {\n  id: string;\n  task_id: string;\n  reviewer_id: string;\n  reviewer_name: string;\n  status: \'Approved\' | \'Changes Requested\' | \'Pending\';\n  feedback?: string;\n  reviewed_at?: string;\n}\n\nexport interface TaskComment {\n  id: string;\n  task_id: string;\n  author_id: string;\n  author_name: string;\n  author_avatar?: string;\n  content: string;\n  created_at: string;\n}\n\nexport interface Task {\n  id: string;\n  project_id: string;\n  issue_key?: string;\n  issue_type?: IssueType;\n  title: string;\n  description?: string;\n  priority: TaskPriority;\n  status: TaskStatus;"
