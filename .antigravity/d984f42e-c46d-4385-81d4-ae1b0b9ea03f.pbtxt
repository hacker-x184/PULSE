        replacement_content: "              {/* Profile & Identity Settings */}\n              <div className=\"px-2 py-1.5 space-y-0.5\">\n                {onOpenProfile && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n                      onOpenProfile();\n                    }}\n                    className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                  >\n                    <UserIcon className=\"w-3.5 h-3.5 text-blue-600\" />\n                    <span>My Profile & Credentials</span>\n                  </button>\n                )}\n\n                {onOpenInvitations && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n                      onOpenInvitations();\n                    }}\n                    className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                  >\n                    <UserPlus className=\"w-3.5 h-3.5 text-emerald-600\" />\n                    <span>Team Invitations & Access</span>\n                  </button>\n                )}\n\n                {onOpenRolePermissions && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n                      onOpenRolePermissions();\n                    }}\n                    className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                  >\n                    <ShieldCheck className=\"w-3.5 h-3.5 text-indigo-600\" />\n                    <span>Role Permissions (RBAC)</span>\n                  </button>\n                )}\n              </div>\n\n              {/* Personal GitHub Integration shortcut */}\n              {onOpenGitHub && (\n                <div className=\"px-2 py-1.5\">\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n                      onOpenGitHub();\n                    }}\n                    className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                  >\n                    <Github className=\"w-3.5 h-3.5 text-slate-800\" />\n                    <span>My Personal GitHub Account</span>\n                  </button>\n                </div>\n              )}\n\n              {/* Account Actions */}\n              <div className=\"px-2 py-1.5 space-y-0.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsUserMenuOpen(false);\n                    onOpenAuth(\'login\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                >\n                  <LogIn className=\"w-3.5 h-3.5 text-blue-600\" />\n                  <span>Switch Account / Sign In</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsUserMenuOpen(false);\n                    onOpenAuth(\'register\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                >\n                  <UserPlus className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  <span>Register New User</span>\n                </button>\n              </div>"
