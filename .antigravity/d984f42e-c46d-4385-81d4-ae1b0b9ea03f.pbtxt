  view_file {
    absolute_path_uri: "file:///server.ts"
    start_line: 3399
    end_line: 3419
    content: "\n  // AI Assistant Query\n  app.post(\'/api/ai/query\', async (req, res) => {\n    const { prompt, project_id } = req.body;\n    if (!prompt || !prompt.trim()) {\n      return res.status(400).json({ detail: \'prompt is required\' });\n    }\n\n    const apiKey = process.env.GEMINI_API_KEY;\n    if (!apiKey) {\n      return res.json({\n        has_api_key: false,\n        response: \'AI Assistant is currently unconfigured because GEMINI_API_KEY is not set in the environment secrets. To enable grounded AI analysis, configure GEMINI_API_KEY. All core features (Projects, Tasks, Team, Contributions, Risks, and CSV Reports) function independently.\',\n        grounding_data_points: 0,\n        sources_used: []\n      });\n    }\n\n    const pFilter = project_id ? \' WHERE id = ?\' : \'\';\n    const projects = queryAll(\'SELECT * FROM projects\' + pFilter, project_id ? [project_id] : []);\n    const tFilter = project_id ? \' WHERE project_id = ?\' : \'\';"
    num_lines: 3507
    num_bytes: 149027
    line_range_bytes: 928
  }
}
