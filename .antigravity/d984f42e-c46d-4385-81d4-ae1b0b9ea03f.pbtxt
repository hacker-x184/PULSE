    content: "import React, { useState } from \'react\';\nimport {\n  FolderKanban,\n  Plus,\n  Search,\n  Filter,\n  Calendar,\n  Users,\n  Edit2,\n  Trash2,\n  ExternalLink,\n  CheckCircle2,\n  AlertCircle\n} from \'lucide-react\';\nimport { Project, ProjectStatus, TeamMember, Task } from \'../../types\';\nimport { Modal } from \'../common/Modal\';\nimport { ConfirmDialog } from \'../common/ConfirmDialog\';\n\ninterface ProjectsPageProps {\n  projects: Project[];\n  tasks: Task[];\n  team: TeamMember[];\n  onSelectProject: (id: string) => void;\n  onCreateProject: (data: Partial<Project>) => Promise<void>;\n  onUpdateProject: (id: string, data: Partial<Project>) => Promise<void>;\n  onDeleteProject: (id: string) => Promise<void>;\n  onNavigateToTasks: (projectId: string) => void;\n}\n\nexport const ProjectsPage: React.FC<ProjectsPageProps> = ({\n  projects,\n  tasks,\n  team,\n  onSelectProject,\n  onCreateProject,\n  onUpdateProject,\n  onDeleteProject,\n  onNavigateToTasks\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n\n  // Modal states\n  const [isCreateOpen, setIsCreateOpen] = useState(false);\n  const [editingProject, setEditingProject] = useState<Project | null>(null);\n  const [deletingProjectId, setDeletingProjectId] = useState<string | null>(null);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [formError, setFormError] = useState<string | null>(null);\n\n  // Form states\n  const [name, setName] = useState(\'\');\n  const [description, setDescription] = useState(\'\');\n  const [startDate, setStartDate] = useState(\'\');\n  const [deadline, setDeadline] = useState(\'\');\n  const [status, setStatus] = useState<ProjectStatus>(\'Planning\');\n  const [selectedMemberIds, setSelectedMemberIds] = useState<string[]>([]);\n\n  const resetForm = () => {\n    setName(\'\');\n    setDescription(\'\');\n    setStartDate(\'\');\n    setDeadline(\'\');\n    setStatus(\'Planning\');\n    setSelectedMemberIds([]);\n    setFormError(null);\n  };\n\n  const handleOpenCreate = () => {\n    resetForm();\n    setIsCreateOpen(true);\n  };\n\n  const handleOpenEdit = (p: Project) => {\n    setName(p.name);\n    setDescription(p.description || \'\');\n    setStartDate(p.start_date || \'\');\n    setDeadline(p.deadline || \'\');\n    setStatus(p.status);\n    setSelectedMemberIds(p.member_ids || []);\n    setFormError(null);\n    setEditingProject(p);\n  };\n\n  const handleSaveProject = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim()) {\n      setFormError(\'Project title is required.\');\n      return;\n    }\n\n    setIsSubmitting(true);\n    setFormError(null);\n    try {\n      if (editingProject) {\n        await onUpdateProject(editingProject.id, {\n          name: name.trim(),\n          description: description.trim() || undefined,\n          start_date: startDate || undefined,\n          deadline: deadline || undefined,\n          status,"
