      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add collaboration and simulation to Sidebar navigation and ActivePage type\", \"EndLine\":48, \"Instruction\":\"Update ActivePage type and SidebarProps in Sidebar.tsx\", \"ReplacementContent\":\"export type ActivePage =\\n  | \'dashboard\'\\n  | \'projects\'\\n  | \'tasks\'\\n  | \'team\'\\n  | \'collaboration\'\\n  | \'simulation\'\\n  | \'contributions\'\\n  | \'risks\'\\n  | \'reports\'\\n  | \'settings\';\\n\\ninterface SidebarProps {\\n  activePage: ActivePage;\\n  onNavigate: (page: ActivePage) => void;\\n  onOpenAI: () => void;\\n  onReseedData: () => void;\\n  isReseeding: boolean;\\n  mobileOpen: boolean;\\n  onCloseMobile: () => void;\\n  currentUser: User | null;\\n  onOpenAuth: (mode?: \'login\' | \'register\') => void;\\n  onOpenProfile?: () => void;\\n  onCreateTask: () => void;\\n  onCreateProject?: () => void;\\n}\", \"StartLine\":26, \"TargetContent\":\"export type ActivePage =\\n  | \'dashboard\'\\n  | \'projects\'\\n  | \'tasks\'\\n  | \'team\'\\n  | \'contributions\'\\n  | \'risks\'\\n  | \'reports\'\\n  | \'settings\';\\n\\ninterface SidebarProps {\\n  activePage: ActivePage;\\n  onNavigate: (page: ActivePage) => void;\\n  onOpenAI: () => void;\\n  onReseedData: () => void;\\n  isReseeding: boolean;\\n  mobileOpen: boolean;\\n  onCloseMobile: () => void;\\n  currentUser: User | null;\\n  onOpenAuth: (mode?: \'login\' | \'register\') => void;\\n  onCreateTask: () => void;\\n  onCreateProject?: () => void;\\n}\", \"TargetFile\":\"/src/components/layout/Sidebar.tsx\", \"toolAction\":\"Updating Sidebar ActivePage type and props\", \"toolSummary\":\"Update Sidebar props and types\"}"
