 \'milestone\', \'/tasks\', 0, ?)`,\n    [now.toISOString(), now.toISOString()]\n  );\n\n  // Seed Discussions\n  execute(\n    `INSERT INTO discussions (id, project_id, author_id, author_name, author_avatar, category, title, content, created_at) VALUES\n    (\'disc-1\', p1Id, \'u-zaid\', \'Zaid Tested\', \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150\', \'Architecture\', \'SQLite WAL Mode concurrency and lock timeouts\', \'We benchmarked WAL pragma with 100 concurrent writers. Latency p99 remained under 12ms. Zero lock starvation observed.\', ?),\n    (\'disc-2\', p1Id, \'u-elena\', \'Elena Rostova\', \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150\', \'Sprint Planning\', \'Sprint 2 Scope & Zero-Trust IAM Federation\', \'Proposal to prioritize OAuth scope authorization over raw Redis caching. Please review the specification draft.\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  // Seed Peer Kudos (Invisible Work recognition)\n  execute(\n    `INSERT INTO peer_kudos (id, project_id, from_name, to_member_id, category, message, created_at) VALUES\n    (\'kd-1\', p1Id, \'Elena Rostova\', m2Id, \'Unblocking Teammates\', \'Huge thanks to Marcus for triaging the distributed lock deadlock under load. Saved the release sprint!\', ?),\n    (\'kd-2\', p1Id, \'Marcus Vance\', m4Id, \'Mentorship & Support\', \'Devon walked the team through the CI linting setup and container configuration. Excellent guidance.\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  // Seed Task Attachments\n  execute(\n    `INSERT INTO task_attachments (id, task_id, file_name, file_size, file_type, uploaded_by, created_at) VALUES\n    (\'att-1\', \'t-101\', \'idempotency-key-partition-spec.pdf\', \'245 KB\', \'application/pdf\', \'Elena Rostova\', ?),\n    (\'att-2\', \'t-102\', \'sqlite-wal-benchmark-results.csv\', \'38 KB\', \'text/csv\', \'Marcus Vance\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  saveDatabase();\n}"
