      thinking_signature: "\022\253\f\n\250\f\001i\024}\023\243\226\355\036B:\275X\033\001v1\200*,1d`^\273\276\266\247h\216\255o\255\242\332\364O\341m\314\370\221#,\267\266VU\314\356c[\305E[\034\037v\220oK\251\255v\3322\323\273\203_\2351\260l\337w\347\006\325\312\254\215\031cA~s^\231+xa\002\026\315|\254\363,\334\027\211\006\251F\270\344m?\027i\030:\256\005\016\222/\355\023\303D\\\001\v\350\245\220Ls\314\247\037\217\251\002\016\237WR\247~l\254#\232?ZB?3\231\003\271\265*\030ja5\236\372c\333\233\354\215\210?\'\r:\206\243\321E\222\305\311\021\001\326V\021\247\004d\207gf\267\202\341\261\235 \253o\024\346v\346\370\215C\\\236<}\243\204\310\331\257\303\212\315\303L\215\364!\021y\004U\033\352D\002[\2318\000[Y\273\362\216\f@i@\216;\341Ms\267\302\243\267\033s;\027\327\371bY{NX\316\216\253`(\004\311\263q^\005\244\304^\360p\362\'b\234\223\003&et\316\233h\347\221\300\2025/\345+\247S$\323\b\376\355\261m^\254\343,\334\037-\341\033\331\275\331\244=\344\314\"\364s\035\363%(\036V\324\022\341:\242^)\202fLLo:\nj\377=\254D\254\315 uv;C\343E*k\005\345Kq\270R^r\310\354D\033\276\311\2227\253\223\223\037i\200\003\204\fM\\0\rTml\305D2\b\a\264\341Y\336\261h\034\336$J\037\243\276\335f\323\004\365\b\275\233\202\221\233\002\242\264L\317\034p\352j\377\304vl\037\251\216PF\252\374\235\330\366\"\365\214\3501\364ipX\240p\352\263\355C\341\231\376L\250\317\265\323He\3044\037\237z\227\236]\211\005\002@/\213t\367dG\324\255\v\312\267\315\216o\212\031>\266\227\325\n\321q\271\235Jb\301\001\347k\030\020?\207\226\225\265\304M\206!V\215\247\022\301O{\004M\337\363\305kQ\031\215\210:\246Y\264\255\222(\2314\317\353dQ\317Y\'\240\325\323\214\223\333S\262\3352e\3325\211N\243\370(c,\017\022=]\267W\024I\r\177\220Bx(T\224\263\256\034\210\374\275\216\215\256q\342M\035\266\305:\250\343$\340\252A\336$\"-S\372[\321\021Ji\264\266Z\032L\366\315x\373\b\244\023\224\344H\224\337#\272\226\224\226\037\325\345\263C8\326\254\021\346r5\246\353Q\241\215\301\374\a\242l\315M\a&\326\230\226/\274[\205\360>)b\351\260YJK\322\334Mg\346\023/G%\302pc\304\323\356\357\034\336\346`\004\210$\310[Zb\301P\344\3745G\247\212\232\357e\374\347\006\305\214:-\255Yp\300\360\'\357\033\303\254\373\3775lRW\022\016\207\027p\b\344\353\316\301bu\256\310\205p\244\207gw\016y-\313vC`3\376:H\205\177{\035k\033l\2423\004 \nY\313;\277\002\302\347\354\353q\277\205\250G\217I\317\234\357z\315\\\270\240\021\344O\237\254\251\037\353:v\237A\254\223\031\373\bR\234:\352s;\241\361\177\344\306,L}\203%<!q\003KU\\\'\332\017L\300y\231\'p\250zg\230,=\357\003^\262\036z\236\226A\t>,\364\332\206\204\372\354VzH\236\224p\322\353\236\242\325K\364\032\256\326\306(\250\034\253\346\341\253G\261\260\371\236G\335\335\233\227\b\255?\221\226\304I6\205s\005\251\365\375\325\276~~\340|\020\037\021\\f\037\021\245{\210A1<D \242\240@\002\317\351H$=\nu\353\234`\373\371H\177\020\307k(\231}\242\"V\244c\310\254S\306K\3743\226\025\326\313P\020\335d;\016e\271\213_Sp\347\267\254\247\035J\226KC\021\035\0176\235\372\037\231\233\304\017\301j\233\f\027\244\a\331\316\203\260\331\fJ\366(\360X*1J\247y\331\242v\255\022\211g\031\331\262\344\212\224\345t;\247$?[\310\f3\033\257A\335\0324B\374\346\255\a\2110\233\254(*$_\022)t\242x\271\316\204\244!\214y\313F\346h\265\362dW\276\260\227\247\240\3147\314\303\235/;A\344I\236\372\362\004\3253\bOy\230\024k\240\v\263JM\272\247\263}1\260\336\270\222^\216\3611\004\a\r\306\207\213\002ad\217d\244\316\311\263\031jr3\026\353:\200A\330\270rWIQ\376\257\354\276\377;\021\004\027{\236^\037\342\025\214\346\034\\\333\022\224\212\275\202\310\355-ii\337>l\277\247B\213\301Y\034V\260S\317M\035\240a\303\324\243\034\356\326M)\256\315**\303\263\361\354N\023g$\3137WHS\256`\265\306J\033\317\342\254\205\300\206\350\310G\357w\377`\232etA\326\272\351\016\223\207y\325\347v\2473\vP?R\223\221\340\357\367\224\202\256 %\32230\023{a\343\304\'=j\376\337\331\032\3536\032F\3175\256J{L\372A\n\243\251\354\024\0237\274\a\213v]\3422\323]L\201\210I\200\035\276(4\n\300y\023\335#\336=\033\263\204\272\331<\376\263\3735\210\253B\303\250\361\267\232\317$G\272\305\251\377R]\037\03334\037\265%3B\004\276\361d\245\207\\\221\341\311\003\211\ng\201 N\b5\265f\214\353C\247\226^+xg\244w\236\302\214\213Z\231\256v\221\206\230\240\330d\214Jc/}!\333L\002\350\r\327\366 \321\256\211S\374\241E\325\273\320M\371\327(t\204\354\vu\2671\030\356G\235\233z\001\317^:\242~\035\b5\230?\254^G\315\324u1\324!\025\257\377j\300P*\227\006/{\226\265w\032\3267\370q@\265\202\261\032\265\245,\233\031\b\r_3\r\342\202Q@1\266\216a;Z\271\371,7\025 \326u\236u\311\337#"
