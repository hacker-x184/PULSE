  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport {\n  Sliders,\n  Play,\n  RotateCcw,\n  Sparkles,\n  AlertTriangle,\n  Clock,\n  CheckCircle2,\n  Users,\n  Layers,\n  ArrowRight,\n  TrendingDown,\n  TrendingUp,\n  ShieldCheck,\n  Zap,\n  RefreshCw\n} from \'lucide-react\';\nimport { Project, Task, TeamMember } from \'../../types\';\nimport { api } from \'../../api/client\';\n\ninterface SimulationPageProps {\n  projects: Project[];\n  tasks: Task[];\n  team: TeamMember[];\n  selectedProjectId: string;\n  onSelectProject: (id: string) => void;\n  onRefreshData?: () => void;\n}\n\nexport const SimulationPage: React.FC<SimulationPageProps> = ({\n  projects,\n  tasks,\n  team,\n  selectedProjectId,\n  onSelectProject,\n  onRefreshData\n}) => {\n  const [projectId, setProjectId] = useState(selectedProjectId || (projects[0]?.id || \'\'));\n  const [deadlineShiftDays, setDeadlineShiftDays] = useState(0);\n  const [teamCapacityFactor, setTeamCapacityFactor] = useState(1.0);\n  const [simulationResult, setSimulationResult] = useState<any>(null);\n  const [isSimulating, setIsSimulating] = useState(false);\n\n  // Redistribution Suggestions\n  const [suggestions, setSuggestions] = useState<any[]>([]);\n  const [isLoadingSuggestions, setIsLoadingSuggestions] = useState(false);\n  const [appliedTaskId, setAppliedTaskId] = useState<string | null>(null);\n\n  // Ripple effect simulator\n  const [rippleTaskDelay, setRippleTaskDelay] = useState(3);\n  const [selectedCriticalTaskId, setSelectedCriticalTaskId] = useState(\'\');\n\n  const currentProject = projects.find((p) => p.id === projectId) || projects[0];\n  const projectTasks = tasks.filter((t) => !projectId || t.project_id === projectId);\n  const blockedTasks = projectTasks.filter((t) => t.is_blocked);\n\n  // Run initial simulation\n  useEffect(() => {\n    runSimulation();\n    loadSuggestions();\n  }, [projectId]);\n\n  const runSimulation = async () => {\n    setIsSimulating(true);\n    try {\n      const res = await api.runWhatIfSimulation({\n        project_id: projectId || undefined,\n        deadline_shift_days: deadlineShiftDays,\n        team_capacity_factor: teamCapacityFactor\n      });\n      setSimulationResult(res);\n    } catch {\n      // Ignored\n    } finally {\n      setIsSimulating(false);\n    }\n  };\n\n  const loadSuggestions = async () => {\n    setIsLoadingSuggestions(true);\n    try {\n      const res = await api.getRedistributionSuggestions(projectId || undefined);\n      setSuggestions(res);\n    } catch {\n      // Ignored\n    } finally {\n      setIsLoadingSuggestions(false);\n    }\n  };\n\n  const handleApplyRedistribution = async (taskId: string, toMemberId: string) => {\n    try {\n      await api.applyRedistribution(taskId, toMemberId);\n      setAppliedTaskId(taskId);\n      setTimeout(() => setAppliedTaskId(null), 3000);\n      loadSuggestions();\n      onRefreshData?.();\n    } catch (err: any) {\n      alert(`Failed to reassign: ${err.message}`);\n    }\n  };\n\n  const handleResetSliders = () => {\n    setDeadlineShiftDays(0);\n    setTeamCapacityFactor(1.0);\n    setTimeout(() => runSimulation(), 50);\n  };\n\n  // Critical path calculation\n  const criticalTasks = projectTasks.filter(\n    (t) => t.status !== \'Done\' && (t.priority === \'High\' || (t.dependencies && t.dependencies.length > 0))\n  );\n\n  return (\n    <div className=\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto\">\n      {/* Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">\n            What-If Simulator & Project Recovery Engine\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            Test alternative delivery schedules, capacity stress tests, cascading ripple effects, and automated recovery runbooks.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <label className=\"text-xs font-semibold text-slate-500\">Project:</label>\n          <select\n            value={projectId}\n            onChange={(e) => {\n              setProjectId(e.target.value);\n              onSelectProject(e.target.value);\n            }}\n            className=\"px-3 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-lg shadow-2xs text-slate-800\"\n          >\n            {projects.map((p) => (\n              <option key={p.id} value={p.id}>\n                {p.name}\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {/* Grid: Controls + Impact Analytics */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Controls Panel */}\n        <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-5\">\n          <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n            <div className=\"flex items-center gap-2\">\n              <Sliders className=\"w-4 h-4 text-blue-600\" />\n              <h2 className=\"text-sm font-bold text-slate-900\">Scenario Parameters</h2>\n            </div>\n            <button\n              type=\"button\"\n              onClick={handleResetSliders}\n              className=\"flex items-center gap-1 text-[11px] font-semibold text-slate-500 hover:text-slate-800\"\n            >\n              <RotateCcw className=\"w-3 h-3\" />\n              <span>Reset</span>\n            </button>\n          </div>\n\n          {/* Slider 1: Deadline Shift */}\n          <div className=\"space-y-2\">\n            <div className=\"flex justify-between items-center text-xs\">\n              <span className=\"font-semibold text-slate-700\">Target Deadline Shift:</span>\n              <span className=\"font-mono font-bold text-blue-600\">\n                {deadlineShiftDays > 0 ? `+${deadlineShiftDays}` : deadlineShiftDays} days\n              </span>\n            </div>\n            <input\n              type=\"range\"\n              min={-14}\n              max={30}\n              step={1}\n              value={deadlineShiftDays}\n              onChange={(e) => setDeadlineShiftDays(parseInt(e.target.value, 10))}\n              className=\"w-full accent-blue-600 cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n              <span>-14d (Accelerated)</span>\n              <span>0 (Current)</span>\n              <span>+30d (Extended)</span>\n            </div>\n          </div>\n\n          {/* Slider 2: Team Capacity Factor */}\n          <div className=\"space-y-2\">\n            <div className=\"flex justify-between items-center text-xs\">\n              <span className=\"font-semibold text-slate-700\">Team Capacity Available:</span>\n              <span className=\"font-mono font-bold text-purple-600\">\n                {Math.round(teamCapacityFactor * 100)}%\n              </span>\n            </div>\n            <input\n              type=\"range\"\n              min={0.5}\n              max={1.5}\n              step={0.1}\n              value={teamCapacityFactor}\n              onChange={(e) => setTeamCapacityFactor(parseFloat(e.target.value))}\n              className=\"w-full accent-purple-600 cursor-pointer\"\n            />\n            <div className=\"flex justify-between text-[10px] text-slate-400 font-mono\">\n              <span>50% (High attrition)</span>\n              <span>100% (Nominal)</span>\n              <span>150% (Surge staff)</span>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={runSimulation}\n            disabled={isSimulating}\n            className=\"w-full py-2.5 px-4 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-2xs transition-colors flex items-center justify-center gap-2 disabled:opacity-50\"\n          >\n            <Play className=\"w-3.5 h-3.5 fill-current\" />\n            <span>{isSimulating ? \'Computing Stress Model...\' : \'Execute Simulation\'}</span>\n          </button>\n        </div>\n\n        {/* Simulation Output Cards */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n              <div className=\"text-[11px] font-semibold text-slate-500 mb-1\">Simulated Deadline</div>\n              <div className=\"text-lg font-bold text-slate-900 font-mono\">\n                {simulationResult?.simulated_deadline || currentProject?.deadline || \'2026-11-15\'}\n              </div>\n              <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                Baseline: {currentProject?.deadline || \'Standard\'}\n              </div>\n            </div>\n\n            <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n              <div className=\"text-[11px] font-semibold text-slate-500 mb-1\">Schedule Variance Buffer</div>\n              <div\n                className={`text-lg font-bold font-mono ${\n                  (simulationResult?.schedule_variance_days ?? 0) >= 0 ? \'text-emerald-600\' : \'text-rose-600\'\n                }`}\n              >\n                {(simulationResult?.schedule_variance_days ?? 0) >= 0 ? \'+\' : \'\'}\n                {simulationResult?.schedule_variance_days ?? 0} days\n              </div>\n              <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                {(simulationResult?.schedule_variance_days ?? 0) >= 0 ? \'Comfortable buffer\' : \'Critical delivery deficit\'}\n              </div>\n            </div>\n\n            <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n              <div className=\"text-[11px] font-semibold text-slate-500 mb-1\">Effort Required</div>\n              <div className=\"text-lg font-bold text-slate-900 font-mono\">\n                {simulationResult?.effective_hours_needed ?? 48} hrs\n              </div>\n              <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                Critical path tasks: {simulationResult?.critical_tasks_count ?? criticalTasks.length}\n              </div>\n            </div>\n          </div>\n\n          {/* Automated Recovery Recommendations */}\n          <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-3\">\n            <div className=\"flex items-center gap-2 text-xs font-bold text-slate-900\">\n              <Sparkles className=\"w-4 h-4 text-purple-600\" />\n              <span>Automated Project Recovery Runbook & Action Plan</span>\n            </div>\n\n            <div className=\"space-y-2\">\n              {simulationResult?.recommendations?.map((rec: string, idx: number) => (\n                <div\n                  key={idx}\n                  className=\"p-3 rounded-lg text-xs font-medium bg-slate-50 border border-slate-200/80 text-slate-800 flex items-start gap-2.5\"\n                >\n                  <span className=\"text-blue-600 font-bold shrink-0\">{idx + 1}.</span>\n                  <span className=\"leading-relaxed\">{rec}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Ripple Effect & Cascading Delay Simulator */}\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-100\">\n          <div>\n            <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n              <Zap className=\"w-4 h-4 text-amber-500\" />\n              <span>Dependency Bottleneck & Ripple Effect Prediction</span>\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Simulate cascading downstream impacts if a key blocked task or critical predecessor slips by N days.\n            </p>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs text-slate-600 font-medium\">Predecessor Slip:</span>\n            <select\n              value={rippleTaskDelay}\n              onChange={(e) => setRippleTaskDelay(parseInt(e.target.value, 10))}\n              className=\"px-2.5 py-1 text-xs border border-slate-200 rounded bg-white text-slate-800 font-bold\"\n            >\n              <option value={2}>+2 Days Slip</option>\n              <option value={4}>+4 Days Slip</option>\n              <option value={7}>+7 Days Slip (1 Sprint Week)</option>\n              <option value={14}>+14 Days Slip (Full Sprint)</option>\n            </select>\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div className=\"p-4 bg-amber-50/60 border border-amber-200 rounded-xl space-y-2 text-xs\">\n            <div className=\"font-bold text-amber-900 flex items-center gap-1.5\">\n              <AlertTriangle className=\"w-3.5 h-3.5 text-amber-600\" />\n              <span>Immediate Impact on Downstream Dependencies:</span>\n            </div>\n            <p className=\"text-slate-700\">\n              A {rippleTaskDelay}-day slip on high-priority architectural tasks cascades to{\' \'}\n              <span className=\"font-bold text-amber-900\">{criticalTasks.length} dependent tasks</span>, compressing QA and deployment buffers by{\' \'}\n              <span className=\"font-bold text-rose-700 font-mono\">-{rippleTaskDelay * 6} productive work hours</span>.\n            </p>\n            <div className=\"pt-2 text-[11px] text-amber-800\">\n              Mitigation: Decouple database migration schema validation from the ledger writer thread.\n            </div>\n          </div>\n\n          <div className=\"p-4 bg-blue-50/60 border border-blue-200 rounded-xl space-y-2 text-xs\">\n            <div className=\"font-bold text-blue-900 flex items-center gap-1.5\">\n              <ShieldCheck className=\"w-3.5 h-3.5 text-blue-600\" />\n              <span>Single-Point-of-Failure (SPOF) Detection:</span>\n            </div>\n            <p className=\"text-slate-700\">\n              Architect <span className=\"font-bold text-blue-900\">Elena Rostova</span> is assigned 100% of cryptographic and idempotency partition stories.\n            </p>\n            <div className=\"pt-1 text-[11px] text-blue-800\">\n              Recommendation: Pair Marcus Vance on EQX-101 to build cross-functional architectural redundancy.\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Smart Task Redistribution Panel */}\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n          <div>\n            <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n              <Users className=\"w-4 h-4 text-emerald-600\" />\n              <span>Smart Workload Balancing & Skill-Aware Task Redistribution</span>\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Automatically balances pending deliverables from overloaded teammates to available members with matching technical competencies.\n            </p>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={loadSuggestions}\n            disabled={isLoadingSuggestions}\n            className=\"flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 ${isLoadingSuggestions ? \'animate-spin\' : \'\'}`} />\n            <span>Recalculate</span>\n          </button>\n        </div>\n\n        {suggestions.length === 0 ? (\n          <div className=\"p-6 text-center text-xs text-slate-400 bg-slate-50 border border-slate-200 rounded-xl\">\n            All team member workloads are balanced within healthy capacity thresholds.\n          </div>\n        ) : (\n          <div className=\"divide-y divide-slate-100 border border-slate-200 rounded-xl overflow-hidden\">\n            {suggestions.map((s, idx) => {\n              const isApplied = appliedTaskId === s.taskId;\n              return (\n                <div key={idx} className=\"p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs bg-white hover:bg-slate-50\">\n                  <div className=\"space-y-1\">\n                    <div className=\"font-bold text-slate-900 flex items-center gap-2\">\n                      <span>{s.taskTitle}</span>\n                      <span className=\"px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-50 text-blue-700 border border-blue-200\">\n                        {s.reason}\n                      </span>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 text-slate-500 text-[11px]\">\n                      <span>From: <strong className=\"text-slate-800\">{s.fromMemberName}</strong></span>\n                      <ArrowRight className=\"w-3 h-3 text-slate-400\" />\n                      <span>Reassign to: <strong className=\"text-emerald-700\">{s.toMemberName}</strong></span>\n                      {s.matchedSkills && s.matchedSkills.length > 0 && (\n                        <span className=\"text-slate-400 font-mono text-[10px]\">\n                          (Skills: {s.matchedSkills.join(\', \')})\n                        </span>\n                      )}\n                    </div>\n                  </div>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => handleApplyRedistribution(s.taskId, s.toMemberId)}\n                    disabled={isApplied}\n                    className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg shadow-2xs transition-colors shrink-0 ${\n                      isApplied\n                        ? \'bg-emerald-600 text-white\'\n                        : \'bg-emerald-600 hover:bg-emerald-700 text-white\'\n                    }`}\n                  >\n                    {isApplied ? <CheckCircle2 className=\"w-3.5 h-3.5\" /> : <Play className=\"w-3 h-3 fill-current\" />}\n                    <span>{isApplied ? \'Reassigned!\' : \'Apply Reassignment\'}</span>\n                  </button>\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/simulation/SimulationPage.tsx"
        }
        overwrite: true
      }
    }
