    content: "      is_connected: Boolean(integration.is_connected),\n      last_synced_at: integration.last_synced_at\n    });\n  });\n\n  // Helper: Synchronize project repository activity (real commits & PRs, status transitions, SQLite persistence)\n  async function syncProjectRepositoryActivity(\n    projectId: string,\n    repoOwner: string,\n    repoName: string,\n    accessToken?: string | null\n  ): Promise<{\n    is_connected: boolean;\n    repo_name: string;\n    commits_count: number;\n    prs_count: number;\n    auto_updated_tasks: Array<{ issue_key: string; old_status: string; new_status: string; reason: string }>;\n    error_message: string | null;\n  }> {\n    let cleanOwner = (repoOwner || \'\').trim();\n    let cleanRepo = (repoName || \'\').trim();\n\n    // Clean if full GitHub URL provided\n    const combined = `${cleanOwner}/${cleanRepo}`;\n    const ghMatch = combined.match(/github\\.com\\/([^/]+)\\/([^/#?]+)/i);\n    if (ghMatch) {\n      cleanOwner = ghMatch[1];\n      cleanRepo = ghMatch[2].replace(/\\.git$/, \'\');\n    } else if (cleanOwner.includes(\'/\')) {\n      const parts = cleanOwner.split(\'/\').filter(Boolean);\n      cleanOwner = parts[0];\n      cleanRepo = parts[1].replace(/\\.git$/, \'\');\n    }\n    cleanRepo = cleanRepo.replace(/\\.git$/, \'\');\n\n    if (!cleanOwner || !cleanRepo) {\n      return {\n        is_connected: false,\n        repo_name: `${cleanOwner}/${cleanRepo}`,\n        commits_count: 0,\n        prs_count: 0,\n        auto_updated_tasks: [],\n        error_message: \'Invalid repository owner or repository name provided.\'\n      };\n    }\n\n    let tokenToUse = accessToken ? accessToken.trim() : null;\n    if (!tokenToUse) {\n      const userInteg = queryOne<{ access_token?: string }>(\'SELECT access_token FROM user_github_integrations WHERE access_token IS NOT NULL LIMIT 1\');\n      if (userInteg?.access_token) {\n        tokenToUse = userInteg.access_token;\n      } else {\n        tokenToUse = process.env.GITHUB_PAT || process.env.GITHUB_TOKEN || null;\n      }\n    }\n\n    const headers: Record<string, string> = {\n      \'Accept\': \'application/vnd.github.v3+json\',\n      \'User-Agent\': \'Equinox-Jira-PM/1.0\'\n    };\n    if (tokenToUse) {\n      headers[\'Authorization\'] = `Bearer ${tokenToUse}`;\n    }\n\n    let rawCommits: any[] = [];\n    let rawPRs: any[] = [];\n    let errorMsg: string | null = null;\n\n    try {\n      const commitRes = await fetch(`https://api.github.com/repos/${cleanOwner}/${cleanRepo}/commits?per_page=30`, { headers });\n      if (commitRes.ok) {\n        rawCommits = await commitRes.json();\n      } else if (commitRes.status === 404) {\n        errorMsg = `Repository \'${cleanOwner}/${cleanRepo}\' not found or is private. If private, please provide a GitHub Personal Access Token.`;\n      } else if (commitRes.status === 403) {\n        errorMsg = \'GitHub API rate limit exceeded. Please configure a Personal Access Token to increase rate limits.\';\n      } else {\n        errorMsg = `GitHub API error: HTTP ${commitRes.status}`;\n      }\n\n      if (!errorMsg) {\n        const prRes = await fetch(`https://api.github.com/repos/${cleanOwner}/${cleanRepo}/pulls?state=all&per_page=30`, { headers });\n        if (prRes.ok) {\n          rawPRs = await prRes.json();\n        }\n      }\n    } catch (err: any) {\n      errorMsg = `Network error connecting to GitHub: ${err.message}`;\n    }\n\n    if (errorMsg) {\n      return {\n        is_connected: false,\n        repo_name: `${cleanOwner}/${cleanRepo}`,\n        commits_count: 0,\n        prs_count: 0,\n        auto_updated_tasks: [],\n        error_message: errorMsg\n      };\n    }\n"
    num_lines: 3507
