    content: "\n    try {\n      const ai = new GoogleGenAI({ apiKey });\n      const systemInstruction = `You are an intelligent project management assistant.\nAnswer questions accurately using ONLY the provided real database records.\nNever invent tasks, team members, or deadlines.\nIf information is not present, clearly state that the data is not available.\nDo not delete records. Be clear, professional, and actionable.`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.8-flash\',\n        contents: `${systemInstruction}\\n\\n${contextText}\\n\\nUser Question: ${prompt}`\n      });\n\n      res.json({\n        has_api_key: true,\n        response: response.text || \'No response generated.\',\n        grounding_data_points: projects.length + tasks.length + members.length,\n        sources_used: [`Projects (${projects.length})`, `Tasks (${tasks.length})`, `Members (${members.length})`]\n      });\n    } catch (err: any) {"
    num_lines: 3507
