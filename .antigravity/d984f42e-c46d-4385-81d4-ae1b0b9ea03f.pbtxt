  view_file {
    absolute_path_uri: "file:///src/components/settings/SettingsPage.tsx"
    start_line: 300
    end_line: 453
    content: "              <input\n                type=\"text\"\n                value={repoName}\n                onChange={e => setRepoName(e.target.value.trim())}\n                placeholder=\"e.g. react, my-project\"\n                className=\"w-full px-3 py-1.5 text-xs text-slate-900 border border-slate-200 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-blue-500 font-mono\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n              Personal Access Token (PAT) (Optional for public repos; required for private or high rate limits)\n            </label>\n            <input\n              type=\"password\"\n              value={patToken}\n              onChange={e => setPatToken(e.target.value)}\n              placeholder=\"ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"\n              className=\"w-full px-3 py-1.5 text-xs text-slate-900 border border-slate-200 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-blue-500 font-mono\"\n            />\n            <p className=\"text-[11px] text-slate-400 mt-1\">\n              Tokens are kept secure on the server and used to fetch real repository activity without mock fallbacks.\n            </p>\n          </div>\n\n          <div className=\"flex items-center justify-between pt-2 flex-wrap gap-2\">\n            <div className=\"flex items-center gap-2\">\n              {ghStatus?.is_connected && (\n                <>\n                  <button\n                    type=\"button\"\n                    onClick={handleImportIssues}\n                    disabled={isImporting}\n                    className=\"px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors disabled:opacity-50 flex items-center gap-1.5\"\n                    title=\"Import active GitHub issues as Jira tasks into this project\"\n                  >\n                    <RefreshCw className={`w-3.5 h-3.5 ${isImporting ? \'animate-spin\' : \'\'}`} />\n                    <span>{isImporting ? \'Importing Issues...\' : \'Import GitHub Issues\'}</span>\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    onClick={handleDisconnect}\n                    disabled={isDisconnecting}\n                    className=\"px-3 py-1.5 text-xs font-semibold text-rose-700 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-lg transition-colors disabled:opacity-50\"\n                  >\n                    {isDisconnecting ? \'Disconnecting...\' : \'Disconnect Repository\'}\n                  </button>\n                </>\n              )}\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={isConnectingGh}\n              className=\"px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors disabled:opacity-50 flex items-center gap-1.5 ml-auto\"\n            >\n              <RefreshCw className={`w-3.5 h-3.5 ${isConnectingGh ? \'animate-spin\' : \'\'}`} />\n              <span>{isConnectingGh ? \'Synchronizing Activity...\' : ghStatus?.is_connected ? \'Re-Sync Repository\' : \'Connect & Fetch Activity\'}</span>\n            </button>\n          </div>\n        </form>\n\n        {ghStatus && ghStatus.is_connected && ghStatus.commits && ghStatus.commits.length > 0 && (\n          <div className=\"mt-4 pt-4 border-t border-slate-100 space-y-3\">\n            <h3 className=\"text-xs font-bold text-slate-700 uppercase tracking-wider\">\n              Synced Activity for: {ghStatus.repo_name}\n            </h3>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {/* Commits */}\n              <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2\">\n                <div className=\"text-xs font-bold text-slate-800\">\n                  Recent Synced Commits ({ghStatus.commits.length})\n                </div>\n                <div className=\"space-y-1.5 max-h-48 overflow-y-auto\">\n                  {ghStatus.commits.slice(0, 6).map((c: any) => (\n                    <div key={c.sha} className=\"text-[11px] font-mono text-slate-600 truncate flex items-center gap-1.5\">\n                      <span className=\"text-blue-600 font-bold\">{c.sha}</span>\n                      <span className=\"truncate\">{c.message}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n\n              {/* PRs */}\n              <div className=\"bg-slate-50 p-3 rounded-lg border border-slate-200 space-y-2\">\n                <div className=\"text-xs font-bold text-slate-800\">\n                  Pull Requests ({ghStatus.pull_requests.length})\n                </div>\n                <div className=\"space-y-1.5 max-h-48 overflow-y-auto\">\n                  {ghStatus.pull_requests.length === 0 ? (\n                    <div className=\"text-[11px] text-slate-400 py-2\">No pull requests found.</div>\n                  ) : (\n                    ghStatus.pull_requests.slice(0, 6).map((pr: any) => (\n                      <div key={pr.id || pr.number} className=\"text-[11px] font-mono text-slate-600 truncate flex items-center gap-1.5\">\n                        <span className=\"text-emerald-600 font-bold\">#{pr.number}</span>\n                        <span className=\"truncate\">{pr.title}</span>\n                        <span className=\"text-slate-400\">({pr.state})</span>\n                      </div>\n                    ))\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Local Python FastAPI Execution Instructions */}\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <Terminal className=\"w-5 h-5 text-blue-600\" />\n            <div>\n              <h2 className=\"text-sm font-bold text-slate-900\">Python FastAPI Backend Architecture</h2>\n              <p className=\"text-xs text-slate-500\">\n                Complete, clean Python FastAPI + SQLAlchemy + SQLite backend located in <code className=\"font-mono text-blue-600\">/backend</code>\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={copyCommands}\n            className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg transition-colors\"\n          >\n            <Copy className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span>{copiedCmd ? \'Copied!\' : \'Copy Commands\'}</span>\n          </button>\n        </div>\n\n        <div className=\"text-xs text-slate-600 leading-relaxed space-y-2\">\n          <p>\n            The project includes complete Python source code in <strong className=\"font-mono text-slate-800\">/backend</strong>, with Pydantic schemas, SQLAlchemy SQLite models, transparent risk engines, automated tests (<code className=\"font-mono text-slate-800\">test_backend.py</code>), and seeders.\n          </p>\n          <div className=\"bg-slate-900 text-slate-200 p-3.5 rounded-lg font-mono text-[11px] overflow-x-auto space-y-1\">\n            <div className=\"text-slate-400\"># 1. Navigate to backend and create virtualenv</div>\n            <div>cd backend</div>\n            <div>python3 -m venv venv</div>\n            <div>source venv/bin/activate  # On Windows: venv\\Scripts\\activate</div>\n            <div className=\"text-slate-400 pt-1\"># 2. Install dependencies & seed database</div>\n            <div>pip install -r requirements.txt</div>\n            <div>python seed.py</div>\n            <div className=\"text-slate-400 pt-1\"># 3. Launch FastAPI server with Swagger docs</div>\n            <div>uvicorn main:app --reload --port 8000</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 454
    num_bytes: 19634
    line_range_bytes: 7980
  }
}
