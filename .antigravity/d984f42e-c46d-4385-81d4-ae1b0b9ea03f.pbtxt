    content: "              </div>\n\n              {healthData?.database_records && (\n                <div className=\"space-y-1.5\">\n                  <div className=\"text-[11px] font-semibold text-slate-500 uppercase tracking-wider\">\n                    Database Table Record Counts:\n                  </div>\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <div className=\"p-2 bg-slate-100/70 border border-slate-200 rounded text-center\">\n                      <div className=\"text-xs font-bold text-slate-900\">{healthData.database_records.projects}</div>\n                      <div className=\"text-[10px] text-slate-500\">Projects</div>\n                    </div>\n                    <div className=\"p-2 bg-slate-100/70 border border-slate-200 rounded text-center\">\n                      <div className=\"text-xs font-bold text-slate-900\">{healthData.database_records.tasks}</div>\n                      <div className=\"text-[10px] text-slate-500\">Tasks</div>\n                    </div>\n                    <div className=\"p-2 bg-slate-100/70 border border-slate-200 rounded text-center\">\n                      <div className=\"text-xs font-bold text-slate-900\">{healthData.database_records.team_members}</div>\n                      <div className=\"text-[10px] text-slate-500\">Members</div>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-3 border-t border-slate-100 flex justify-end\">\n              <button\n                type=\"button\"\n                onClick={() => setShowHealthModal(false)}\n                className=\"px-4 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors\"\n              >\n                Close Diagnostics\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
