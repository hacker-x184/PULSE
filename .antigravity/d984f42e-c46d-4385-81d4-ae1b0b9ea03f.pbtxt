    thinking: "**Implementing Attachment Features**\n\nI\'ve begun implementing attachment features within `JiraIssueDetailModal.tsx`. I\'ve added state variables for `attachments`, `newFileName`, and `isAddingAttachment`. The next step is to integrate these into the `useEffect` hook to manage the attachment lifecycle.\n\n\n"
    tool_calls {
      id: "call_665702"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add attachment state and handlers in JiraIssueDetailModal\", \"EndLine\":106, \"Instruction\":\"Add attachment state, fetch, and handlers\", \"ReplacementContent\":\"  const [isLoadingCommits, setIsLoadingCommits] = useState(false);\\n  const [isCopied, setIsCopied] = useState(false);\\n  const [isSaving, setIsSaving] = useState(false);\\n  const [saveSuccess, setSaveSuccess] = useState(false);\\n\\n  // Attachments State\\n  const [attachments, setAttachments] = useState<any[]>([]);\\n  const [newFileName, setNewFileName] = useState(\'\');\\n  const [isAddingAttachment, setIsAddingAttachment] = useState(false);\\n\\n  // Sync state when task changes\\n  useEffect(() => {\\n    setTitle(task.title);\\n    setDescription(task.description || \'\');\\n    setStatus(task.status);\\n    setPriority(task.priority);\\n    setIssueType(task.issue_type || \'Story\');\\n    setStoryPoints(task.story_points || 3);\\n    setSprint(task.sprint || project?.current_sprint || \'Sprint 1 (Active)\');\\n    setAssigneeId(task.assignee_id || \'\');\\n    setDueDate(task.due_date || \'\');\\n    setEstimatedHours(task.estimated_hours || 0);\\n\\n    // Fetch attachments\\n    api.getTaskAttachments(task.id)\\n      .then(res => setAttachments(res || []))\\n      .catch(() => setAttachments([]));\\n\\n    // Fetch linked commits & PRs for this issue key\\n    setIsLoadingCommits(true);\\n    api.getTaskLinkedCommits(task.id)\\n      .then(res => {\\n        setIsRepoConnected(Boolean(res.is_repo_connected));\\n        setLinkedCommits(res.commits || []);\\n        setLinkedPRs(res.pull_requests || []);\\n        setRecentCommits(res.recent_repo_commits || []);\\n        setRepoName(res.repository || \'\');\\n      })\\n      .catch(() => {\\n        setIsRepoConnected(false);\\n        setLinkedCommits([]);\\n        setLinkedPRs([]);\\n        setRecentCommits([]);\\n      })\\n      .finally(() => {\\n        setIsLoadingCommits(false);\\n      });\\n  }, [task]);\\n\\n  const handleAddAttachment = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!newFileName.trim()) return;\\n    setIsAddingAttachment(true);\\n    try {\\n      const res = await api.addTaskAttachment(task.id, {\\n        file_name: newFileName.trim(),\\n        file_size: `${(Math.random() * 400 + 50).toFixed(0)} KB`,\\n        file_type: newFileName.endsWith(\'.pdf\') ? \'application/pdf\' : \'text/plain\'\\n      });\\n      setAttachments([res, ...attachments]);\\n      setNewFileName(\'\');\\n    } catch {} finally {\\n      setIsAddingAttachment(false);\\n    }\\n  };\\n\\n  const handleDeleteAttachment = async (attId: string) => {\\n    try {\\n      await api.deleteTaskAttachment(task.id, attId);\\n      setAttachments(attachments.filter(a => a.id !== attId));\\n    } catch {}\\n  };\", \"StartLine\":68, \"TargetContent\":\"  const [isLoadingCommits, setIsLoadingCommits] = useState(false);\\n  const [isCopied, setIsCopied] = useState(false);\\n  const [isSaving, setIsSaving] = useState(false);\\n  const [saveSuccess, setSaveSuccess] = useState(false);\\n\\n  // Sync state when task changes\\n  useEffect(() => {\\n    setTitle(task.title);\\n    setDescription(task.description || \'\');\\n    setStatus(task.status);\\n    setPriority(task.priority);\\n    setIssueType(task.issue_type || \'Story\');\\n    setStoryPoints(task.story_points || 3);\\n    setSprint(task.sprint || project?.current_sprint || \'Sprint 1 (Active)\');\\n    setAssigneeId(task.assignee_id || \'\');\\n    setDueDate(task.due_date || \'\');\\n    setEstimatedHours(task.estimated_hours || 0);\\n\\n    // Fetch linked commits & PRs for this issue key\\n    setIsLoadingCommits(true);\\n    api.getTaskLinkedCommits(task.id)\\n      .then(res => {\\n        setIsRepoConnected(Boolean(res.is_repo_connected));\\n        setLinkedCommits(res.commits || []);\\n        setLinkedPRs(res.pull_requests || []);\\n        setRecentC