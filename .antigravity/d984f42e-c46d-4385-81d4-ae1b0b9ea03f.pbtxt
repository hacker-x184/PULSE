  view_file {
    absolute_path_uri: "file:///src/components/layout/Sidebar.tsx"
    end_line: 455
    content: "import React, { useState, useRef, useEffect } from \'react\';\nimport {\n  LayoutDashboard,\n  FolderKanban,\n  CheckSquare,\n  Users,\n  BarChart3,\n  ShieldAlert,\n  FileText,\n  Settings,\n  Database,\n  RefreshCw,\n  Sparkles,\n  ChevronDown,\n  Building2,\n  Check,\n  ShieldCheck,\n  Plus,\n  LogIn,\n  Activity,\n  FileCode,\n  ExternalLink\n} from \'lucide-react\';\nimport { User } from \'../../types\';\n\nexport type ActivePage =\n  | \'dashboard\'\n  | \'projects\'\n  | \'tasks\'\n  | \'team\'\n  | \'contributions\'\n  | \'risks\'\n  | \'reports\'\n  | \'settings\';\n\ninterface SidebarProps {\n  activePage: ActivePage;\n  onNavigate: (page: ActivePage) => void;\n  onOpenAI: () => void;\n  onReseedData: () => void;\n  isReseeding: boolean;\n  mobileOpen: boolean;\n  onCloseMobile: () => void;\n  currentUser: User | null;\n  onOpenAuth: (mode?: \'login\' | \'register\') => void;\n  onCreateTask: () => void;\n  onCreateProject?: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activePage,\n  onNavigate,\n  onOpenAI,\n  onReseedData,\n  isReseeding,\n  mobileOpen,\n  onCloseMobile,\n  currentUser,\n  onOpenAuth,\n  onCreateTask,\n  onCreateProject\n}) => {\n  const [isPlatformMenuOpen, setIsPlatformMenuOpen] = useState(false);\n  const [activeWorkspace, setActiveWorkspace] = useState(\'Equinox Enterprise Org\');\n  const [showHealthModal, setShowHealthModal] = useState(false);\n  const [healthData, setHealthData] = useState<any>(null);\n\n  const menuRef = useRef<HTMLDivElement>(null);\n\n  const workspaces = [\n    { id: \'ws-main\', name: \'Equinox Enterprise Org\', role: \'Primary Production\' },\n    { id: \'ws-fintech\', name: \'Fintech Modernization Division\', role: \'Active Sprints\' },\n    { id: \'ws-platform\', name: \'Core Infrastructure & Reliability\', role: \'Internal Ops\' }\n  ];\n\n  // Close menu when clicking outside\n  useEffect(() => {\n    function handleClickOutside(event: MouseEvent) {\n      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {\n        setIsPlatformMenuOpen(false);\n      }\n    }\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const navItems = [\n    { id: \'dashboard\' as ActivePage, label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'projects\' as ActivePage, label: \'Projects\', icon: FolderKanban },\n    { id: \'tasks\' as ActivePage, label: \'Task Management\', icon: CheckSquare },\n    { id: \'team\' as ActivePage, label: \'Team Management\', icon: Users },\n    { id: \'contributions\' as ActivePage, label: \'Contribution Analysis\', icon: BarChart3 },\n    { id: \'risks\' as ActivePage, label: \'Risk Analysis\', icon: ShieldAlert },\n    { id: \'reports\' as ActivePage, label: \'Reports & Export\', icon: FileText },\n    { id: \'settings\' as ActivePage, label: \'Settings\', icon: Settings },\n  ];\n\n  const handleNavClick = (id: ActivePage) => {\n    onNavigate(id);\n    onCloseMobile();\n  };\n\n  const handleFetchHealth = async () => {\n    try {\n      const res = await fetch(\'/api/health\');\n      const data = await res.json();\n      setHealthData(data);\n      setShowHealthModal(true);\n    } catch {\n      setHealthData({ status: \'connected\', engine: \'Express + SQLite\' });\n      setShowHealthModal(true);\n    }\n  };\n\n  return (\n    <>\n      {/* Mobile backdrop */}\n      {mobileOpen && (\n        <div\n          className=\"fixed inset-0 z-40 bg-slate-900/50 md:hidden\"\n          onClick={onCloseMobile}\n          aria-hidden=\"true\"\n        />\n      )}\n\n      <aside\n        className={`fixed top-0 bottom-0 left-0 z-40 w-64 bg-slate-900 text-slate-300 flex flex-col border-r border-slate-800 transition-transform duration-200 ease-in-out md:translate-x-0 ${\n          mobileOpen ? \'translate-x-0\' : \'-translate-x-full\'\n        }`}\n      >\n        {/* Brand header with Interactive Menu Bar Dropdown */}\n        <div className=\"relative border-b border-slate-800\" ref={menuRef}>\n          <button\n            type=\"button\"\n            onClick={() => setIsPlatformMenuOpen(!isPlatformMenuOpen)}\n            className=\"w-full h-16 flex items-center justify-between px-4 hover:bg-slate-800/60 transition-colors text-left group\"\n            title=\"Equinox Platform Menu Bar\"\n          >\n            <div className=\"flex items-center gap-2.5 min-w-0\">\n              <div className=\"w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-base shadow-sm shrink-0\">\n                E\n              </div>\n              <div className=\"min-w-0\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"text-sm font-bold tracking-tight text-white truncate\">\n                    Equinox Platform\n                  </span>\n                </div>\n                <div className=\"text-[11px] text-slate-400 font-mono flex items-center gap-1 truncate\">\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse\"></span>\n                  <span className=\"truncate\">{activeWorkspace.split(\' \')[0]}</span>\n                  <span>\302\267 v1.0</span>\n                </div>\n              </div>\n            </div>\n            <div className=\"p-1 rounded text-slate-400 group-hover:text-white group-hover:bg-slate-700/60 transition-colors\">\n              <ChevronDown className={`w-4 h-4 transition-transform ${isPlatformMenuOpen ? \'rotate-180 text-blue-400\' : \'\'}`} />\n            </div>\n          </button>\n\n          {/* Quick Action Menu Bar Under Brand */}\n          <div className=\"px-3 py-1.5 bg-slate-950/60 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-medium\">\n            <span className=\"text-slate-500 font-mono text-[10px] uppercase tracking-wider\">Menu:</span>\n            <div className=\"flex items-center gap-1\">\n              <button\n                type=\"button\"\n                onClick={() => setIsPlatformMenuOpen(!isPlatformMenuOpen)}\n                className=\"px-1.5 py-0.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition-colors text-[10px]\"\n              >\n                Workspaces\n              </button>\n              <span className=\"text-slate-700\">|</span>\n              <button\n                type=\"button\"\n                onClick={handleFetchHealth}\n                className=\"px-1.5 py-0.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition-colors text-[10px]\"\n              >\n                Health\n              </button>\n              <span className=\"text-slate-700\">|</span>\n              <button\n                type=\"button\"\n                onClick={() => onOpenAuth(\'login\')}\n                className=\"px-1.5 py-0.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition-colors text-[10px]\"\n              >\n                Account\n              </button>\n            </div>\n          </div>\n\n          {/* Equinox Platform Dropdown Menu */}\n          {isPlatformMenuOpen && (\n            <div className=\"absolute top-full left-2 right-2 mt-1 z-50 bg-slate-800 border border-slate-700 rounded-xl shadow-xl overflow-hidden py-2 text-xs divide-y divide-slate-700/60 animate-in fade-in slide-in-from-top-2 duration-150\">\n              {/* Workspaces Section */}\n              <div className=\"px-2 py-1.5\">\n                <div className=\"px-2 pb-1 text-[10px] font-semibold text-slate-400 uppercase tracking-wider\">\n                  Select Active Workspace\n                </div>\n                {workspaces.map((ws) => (\n                  <button\n                    key={ws.id}\n                    type=\"button\"\n                    onClick={() => {\n                      setActiveWorkspace(ws.name);\n                      setIsPlatformMenuOpen(false);\n                    }}\n                    className={`w-full flex items-center justify-between px-2.5 py-2 rounded-lg text-left transition-colors ${\n                      activeWorkspace === ws.name\n                        ? \'bg-blue-600/30 text-white font-semibold\'\n                        : \'text-slate-300 hover:bg-slate-700/60\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-2 truncate\">\n                      <Building2 className={`w-3.5 h-3.5 shrink-0 ${activeWorkspace === ws.name ? \'text-blue-400\' : \'text-slate-400\'}`} />\n                      <div className=\"truncate\">\n                        <div className=\"truncate text-xs\">{ws.name}</div>\n                        <div className=\"text-[10px] text-slate-400 font-mono\">{ws.role}</div>\n                      </div>\n                    </div>\n                    {activeWorkspace === ws.name && (\n                      <Check className=\"w-3.5 h-3.5 text-blue-400 shrink-0 ml-2\" />\n                    )}\n                  </button>\n                ))}\n              </div>\n\n              {/* Quick Platform Actions */}\n              <div className=\"px-2 py-1.5 space-y-0.5\">\n                <div className=\"px-2 pb-1 text-[10px] font-semibold text-slate-400 uppercase tracking-wider\">\n                  Platform Operations\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsPlatformMenuOpen(false);\n                    onCreateTask();\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700/60 transition-colors\"\n                >\n                  <Plus className=\"w-3.5 h-3.5 text-blue-400\" />\n                  <span>New Deliverable Task</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsPlatformMenuOpen(false);\n                    onOpenAI();\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700/60 transition-colors\"\n                >\n                  <Sparkles className=\"w-3.5 h-3.5 text-blue-400\" />\n                  <span>Open AI Assistant</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsPlatformMenuOpen(false);\n                    handleFetchHealth();\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700/60 transition-colors\"\n                >\n                  <Activity className=\"w-3.5 h-3.5 text-emerald-400\" />\n                  <span>System Diagnostics & DB Status</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsPlatformMenuOpen(false);\n                    onReseedData();\n                  }}\n                  className=\"w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700/60 transition-colors\"\n                >\n                  <RefreshCw className=\"w-3.5 h-3.5 text-amber-400\" />\n                  <span>Reset Demo Database Fixtures</span>\n                </button>\n              </div>\n\n              {/* Authentication & User Section */}\n              <div className=\"px-2 py-1.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsPlatformMenuOpen(false);\n                    onOpenAuth(\'login\');\n                  }}\n                  className=\"w-full flex items-center justify-between px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700/60 transition-colors\"\n                >\n                  <div className=\"flex items-center gap-2\">\n                    <LogIn className=\"w-3.5 h-3.5 text-blue-400\" />\n                    <span>\n                      {currentUser ? `Signed in as ${currentUser.name.split(\' \')[0]}` : \'Sign In / Register\'}\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] font-mono text-slate-400\">Auth</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* Navigation list */}\n        <nav className=\"flex-1 px-3 py-4 space-y-1 overflow-y-auto\" aria-label=\"Main Navigation\">\n          <div className=\"px-3 pb-2 text-[11px] font-semibold text-slate-400 tracking-wider\">\n            WORKSPACES\n          </div>\n          {navItems.map(item => {\n            const Icon = item.icon;\n            const isActive = activePage === item.id;\n            return (\n              <button\n                key={item.id}\n                type=\"button\"\n                onClick={() => handleNavClick(item.id)}\n                className={`w-full flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-colors whitespace-nowrap ${\n                  isActive\n                    ? \'bg-blue-600 text-white shadow-xs\'\n                    : \'text-slate-400 hover:text-white hover:bg-slate-800/70\'\n                }`}\n              >\n                <Icon className={`w-4 h-4 shrink-0 ${isActive ? \'text-white\' : \'text-slate-400\'}`} />\n                <span className=\"truncate\">{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Bottom actions & DB status */}\n        <div className=\"p-3 border-t border-slate-800 space-y-2\">\n          {/* Active user preview in sidebar footer */}\n          <div\n            onClick={() => onOpenAuth(\'login\')}\n            className=\"flex items-center justify-between px-2.5 py-1.5 rounded-lg bg-slate-950/40 border border-slate-800 cursor-pointer hover:bg-slate-800/60 transition-colors\"\n            title=\"Click to switch user or sign in\"\n          >\n            <div className=\"flex items-center gap-2 truncate\">\n              <div className=\"w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-[10px] shrink-0\">\n                {currentUser?.name ? currentUser.name.charAt(0).toUpperCase() : \'Z\'}\n              </div>\n              <div className=\"truncate\">\n                <div className=\"text-xs font-medium text-slate-200 truncate\">\n                  {currentUser?.name || \'Zaid Tested\'}\n                </div>\n                <div className=\"text-[9px] text-slate-400 truncate\">\n                  {currentUser?.role || \'Project Director\'}\n                </div>\n              </div>\n            </div>\n            <span className=\"text-[9px] font-mono text-blue-400\">Auth</span>\n          </div>\n\n          {/* AI assistant trigger */}\n          <button\n            type=\"button\"\n            onClick={onOpenAI}\n            className=\"w-full flex items-center justify-between px-3 py-2 text-xs font-medium text-slate-200 bg-slate-800/80 hover:bg-slate-800 rounded-lg border border-slate-700/60 transition-colors\"\n          >\n            <div className=\"flex items-center gap-2\">\n              <Sparkles className=\"w-3.5 h-3.5 text-blue-400\" />\n              <span>AI Grounded Query</span>\n            </div>\n            <span className=\"text-[10px] text-slate-400 font-mono\">Ask</span>\n          </button>\n\n          {/* Quick Reseed DB action */}\n          <button\n            type=\"button\"\n            onClick={onReseedData}\n            disabled={isReseeding}\n            title=\"Reset database to realistic test baseline\"\n            className=\"w-full flex items-center justify-between px-3 py-1.5 text-xs text-slate-400 hover:text-slate-200 hover:bg-slate-800/50 rounded-lg transition-colors disabled:opacity-50\"\n          >\n            <div className=\"flex items-center gap-2\">\n              <RefreshCw className={`w-3.5 h-3.5 ${isReseeding ? \'animate-spin text-blue-400\' : \'\'}`} />\n              <span>{isReseeding ? \'Resetting...\' : \'Reset Demo DB\'}</span>\n            </div>\n            <Database className=\"w-3 h-3 text-slate-400\" />\n          </button>\n        </div>\n      </aside>\n\n      {/* System Diagnostics Modal from Menu Bar */}\n      {showHealthModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4\">\n          <div className=\"bg-white rounded-xl shadow-xl max-w-md w-full p-5 border border-slate-200 animate-in fade-in zoom-in-95 duration-150\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <Activity className=\"w-4 h-4 text-emerald-600\" />\n                <h3 className=\"text-sm font-bold text-slate-900\">Platform System Diagnostics</h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowHealthModal(false)}\n                className=\"text-xs font-semibold text-slate-400 hover:text-slate-700\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"py-4 space-y-3 text-xs text-slate-700\">\n              <div className=\"p-2.5 bg-slate-50 border border-slate-200 rounded-lg space-y-1\">\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500 font-medium\">Status:</span>\n                  <span className=\"text-emerald-700 font-bold font-mono\">200 OK \302\267 Healthy</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500 font-medium\">Database:</span>\n                  <span className=\"text-slate-800 font-mono\">SQLite (WAL mode enabled)</span>\n                </div>\n                <div className=\"flex justify-between\">\n                  <span className=\"text-slate-500 font-medium\">API Server:</span>\n                  <span className=\"text-slate-800 font-mono\">FastAPI-compatible Express</span>\n                </div>\n              </div>\n\n              {healthData?.database_records && (\n                <div className=\"space-y-1.5\">\n                  <div className=\"text-[11px] font-semibold text-slate-500 uppercase tracking-wider\">\n                    Database Table Record Counts:\n                  </div>\n                  <div className=\"grid grid-cols-3 gap-2\">\n                    <div className=\"p-2 bg-slate-100/70 border border-slate-200 rounded text-center\">\n                      <div className=\"text-xs font-bold text-slate-900\">{healthData.database_records.projects}</div>\n                      <div className=\"text-[10px] text-slate-500\">Projects</div>\n                    </div>\n                    <div className=\"p-2 bg-slate-100/70 border border-slate-200 rounded text-center\">\n                      <div className=\"text-xs font-bold text-slate-900\">{healthData.database_records.tasks}</div>\n                      <div className=\"text-[10px] text-slate-500\">Tasks</div>\n                    </div>\n                    <div className=\"p-2 bg-slate-100/70 border border-slate-200 rounded text-center\">\n                      <div className=\"text-xs font-bold text-slate-900\">{healthData.database_records.team_members}</div>\n                      <div className=\"text-[10px] text-slate-500\">Members</div>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <div className=\"pt-3 border-t border-slate-100 flex justify-end\">\n              <button\n                type=\"button\"\n                onClick={() => setShowHealthModal(false)}\n                className=\"px-4 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors\"\n              >\n                Close Diagnostics\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </>\n  );\n};\n"
    num_lines: 456
