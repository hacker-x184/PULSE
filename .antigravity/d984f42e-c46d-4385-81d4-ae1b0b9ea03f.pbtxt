    content: "            <div className=\"w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs ring-2 ring-slate-100 shadow-2xs group-hover:ring-blue-500 transition-all\">\n              {initials}\n            </div>\n            <div className=\"hidden xl:block text-left\">\n              <div className=\"text-xs font-semibold text-slate-900 leading-tight flex items-center gap-1\">\n                <span>{displayName}</span>\n                <ChevronDown className=\"w-3 h-3 text-slate-400 group-hover:text-slate-600\" />\n              </div>\n              <div className=\"text-[10px] text-slate-500 font-mono truncate max-w-[140px]\">\n                {displayEmail}\n              </div>\n            </div>\n          </button>\n\n          {/* User Profile Dropdown Menu */}\n          {isUserMenuOpen && (\n            <div className=\"absolute right-0 mt-2 w-64 bg-white border border-slate-200 rounded-xl shadow-lg z-50 py-2 divide-y divide-slate-100 animate-in fade-in slide-in-from-top-2 duration-150\">\n              {/* Account Overview */}\n              <div className=\"px-4 py-2.5\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <ShieldCheck className=\"w-4 h-4 text-blue-600 shrink-0\" />\n                  <span className=\"text-xs font-bold text-slate-900\">Signed In</span>\n                </div>\n                <div className=\"text-xs font-semibold text-slate-800\">{displayName}</div>\n                <div className=\"text-[11px] text-slate-500 font-mono truncate\">{displayEmail}</div>\n                <div className=\"mt-1.5 flex items-center gap-1.5\">\n                  <span className=\"inline-block text-[10px] font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200\">\n                    {displayRole}\n                  </span>\n                  <span className=\"inline-block text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200\">\n                    Admin Access\n                  </span>\n                </div>\n              </div>\n\n              {/* Personal GitHub Integration shortcut */}\n              {onOpenGitHub && (\n                <div className=\"px-2 py-1.5\">\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n                      onOpenGitHub();\n                    }}\n                    className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                  >\n                    <Github className=\"w-3.5 h-3.5 text-slate-800\" />\n                    <span>My Personal GitHub Account</span>\n                  </button>\n                </div>\n              )}\n\n              {/* Account Actions */}\n              <div className=\"px-2 py-1.5 space-y-0.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsUserMenuOpen(false);\n                    onOpenAuth(\'login\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                >\n                  <LogIn className=\"w-3.5 h-3.5 text-blue-600\" />\n                  <span>Switch Account / Sign In</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsUserMenuOpen(false);\n                    onOpenAuth(\'register\');\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                >\n                  <UserPlus className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  <span>Register New User</span>\n                </button>\n              </div>\n\n              {/* Logout */}\n              <div className=\"px-2 py-1.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => {\n                    setIsUserMenuOpen(false);\n                    onLogout();\n                  }}\n                  className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-rose-600 hover:bg-rose-50 rounded-lg transition-colors text-left\"\n                >\n                  <LogOut className=\"w-3.5 h-3.5 text-rose-600\" />\n                  <span>Sign Out</span>\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n\n"
    num_lines: 401
    num_bytes: 17009
    line_range_bytes: 4681
  }
