    content: "import React from \'react\';\nimport {\n  FolderKanban,\n  CheckCircle2,\n  Clock,\n  AlertTriangle,\n  ArrowRight,\n  ShieldAlert,\n  Calendar,\n  Users\n} from \'lucide-react\';\nimport { ResponsiveContainer, BarChart, Bar, XAxis, YAxis, Tooltip, CartesianGrid } from \'recharts\';\nimport { DashboardMetrics, Project, TeamMember } from \'../../types\';\nimport { ActivePage } from \'../layout/Sidebar\';\n\ninterface DashboardPageProps {\n  metrics: DashboardMetrics | null;\n  projects: Project[];\n  team: TeamMember[];\n  isLoading: boolean;\n  onNavigate: (page: ActivePage) => void;\n  onSelectProject: (id: string) => void;\n  onNewTask: () => void;\n}\n\nexport const DashboardPage: React.FC<DashboardPageProps> = ({\n  metrics,\n  projects,\n  team,\n  isLoading,\n  onNavigate,\n  onSelectProject,\n  onNewTask\n}) => {\n  if (isLoading || !metrics) {\n    return (\n      <div className=\"p-6 space-y-6\">\n        <div className=\"h-8 bg-slate-200 rounded-lg w-64 animate-pulse\" />\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n          {[...Array(4)].map((_, i) => (\n            <div key={i} className=\"h-28 bg-slate-100 rounded-xl border border-slate-200 animate-pulse\" />\n          ))}\n        </div>\n      </div>\n    );\n  }\n\n  // Workload chart data\n  const workloadChartData = metrics.team_workload_summary.map(m => ({\n    name: m.name.split(\' \')[0],\n    fullName: m.name,\n    Completed: m.completed,\n    Pending: m.pending,\n    Overdue: m.overdue,\n  }));\n\n  return (\n    <div className=\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto\">\n      {/* Page Header */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">\n            Executive Project & Risk Overview\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            Real-time delivery health, team workloads, and rule-based risk evaluation.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'tasks\')}\n            className=\"px-3.5 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 shadow-2xs transition-colors\"\n          >\n            View Task Board\n          </button>\n          <button\n            type=\"button\"\n            onClick={onNewTask}\n            className=\"px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-2xs transition-colors\"\n          >\n            + Create Task\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Stats Grid */}\n      <div className=\"grid grid-cols-2 lg:grid-cols-5 gap-3 sm:gap-4\">\n        {/* Total Projects */}\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-medium\">Total Projects</span>\n            <FolderKanban className=\"w-4 h-4 text-blue-600\" />\n          </div>\n          <div className=\"text-2xl font-bold text-slate-900 tabular-nums\">\n            {metrics.total_projects}\n          </div>\n          <div className=\"text-[11px] text-slate-400 mt-1\">\n            Active in workspace\n          </div>\n        </div>\n\n        {/* Total Tasks */}\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-medium\">Total Deliverables</span>\n            <CheckCircle2 className=\"w-4 h-4 text-slate-500\" />\n          </div>\n          <div className=\"text-2xl font-bold text-slate-900 tabular-nums\">\n            {metrics.total_tasks}\n          </div>\n          <div className=\"text-[11px] text-slate-400 mt-1\">\n            Across all project backlogs\n          </div>\n        </div>\n\n        {/* Completed Rate */}\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-medium\">Completion Rate</span>\n            <span className=\"text-xs font-semibold text-emerald-600 font-mono\">\n              {metrics.completed_tasks}/{metrics.total_tasks}\n            </span>\n          </div>\n          <div className=\"text-2xl font-bold text-slate-900 tabular-nums\">\n            {metrics.overall_completion_percentage}%\n          </div>\n          <div className=\"w-full bg-slate-100 rounded-full h-1.5 mt-2 overflow-hidden\">\n            <div\n              className=\"bg-emerald-600 h-1.5 rounded-full transition-all duration-300\"\n              style={{ width: `${Math.min(100, metrics.overall_completion_percentage)}%` }}\n            />\n          </div>\n        </div>\n\n        {/* Pending Tasks */}\n        <div className=\"bg-white p-4 rounded-xl border border-slate-200 shadow-2xs\">\n          <div className=\"flex items-center justify-between text-slate-500 mb-2\">\n            <span className=\"text-xs font-medium\">In Flight / Pending</span>"
    num_lines: 404
    num_bytes: 17356
    line_range_bytes: 5192
  }
}
