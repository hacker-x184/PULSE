    end_line: 139
    content: "import React, { useState, useEffect } from \'react\';\nimport { Lock, Mail, User as UserIcon, Briefcase, AlertCircle, CheckCircle2, ShieldCheck, ArrowRight } from \'lucide-react\';\nimport { Modal } from \'../common/Modal\';\nimport { api } from \'../../api/client\';\nimport { User } from \'../../types\';\n\ninterface AuthModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAuthSuccess: (user: User) => void;\n  initialMode?: \'login\' | \'register\';\n}\n\nexport const AuthModal: React.FC<AuthModalProps> = ({\n  isOpen,\n  onClose,\n  onAuthSuccess,\n  initialMode = \'login\'\n}) => {\n  const [mode, setMode] = useState<\'login\' | \'register\' | \'reset\'>(initialMode);\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [name, setName] = useState(\'\');\n  const [role, setRole] = useState(\'Senior Engineer\');\n\n  useEffect(() => {\n    if (isOpen) {\n      setMode(initialMode);\n      setErrorMessage(null);\n      setSuccessMessage(null);\n    }\n  }, [isOpen, initialMode]);\n\n  const [isLoading, setIsLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n\n  const resetForm = () => {\n    setEmail(\'\');\n    setPassword(\'\');\n    setName(\'\');\n    setRole(\'Senior Engineer\');\n    setErrorMessage(null);\n    setSuccessMessage(null);\n  };\n\n  const handleDemoLogin = async (demoEmail: string, demoPass: string) => {\n    setIsLoading(true);\n    setErrorMessage(null);\n    try {\n      const res = await api.login({ email: demoEmail, password: demoPass });\n      setSuccessMessage(`Welcome back, ${res.user.name}`);\n      setTimeout(() => {\n        onAuthSuccess(res.user);\n        onClose();\n        resetForm();\n      }, 500);\n    } catch (err: any) {\n      setErrorMessage(err.message || \'Demo login failed\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMessage(null);\n    setIsLoading(true);\n\n    try {\n      if (mode === \'login\') {\n        const res = await api.login({ email, password });\n        setSuccessMessage(`Welcome back, ${res.user.name}!`);\n        setTimeout(() => {\n          onAuthSuccess(res.user);\n          onClose();\n          resetForm();\n        }, 500);\n      } else if (mode === \'register\') {\n        if (!name.trim()) {\n          setErrorMessage(\'Full name is required\');\n          setIsLoading(false);\n          return;\n        }\n        const res = await api.register({\n          name: name.trim(),\n          email: email.trim(),\n          password,\n          role\n        });\n        setSuccessMessage(`Account created successfully! Logged in as ${res.user.name}`);\n        setTimeout(() => {\n          onAuthSuccess(res.user);\n          onClose();\n          resetForm();\n        }, 600);\n      } else {\n        await api.resetPassword(email.trim(), password);\n        setSuccessMessage(\'Password updated successfully! Please sign in with your new credentials.\');\n        setTimeout(() => {\n          setMode(\'login\');\n          setPassword(\'\');\n          setErrorMessage(null);\n        }, 1500);\n      }\n    } catch (err: any) {\n      setErrorMessage(err.message || \'Operation failed. Please verify credentials.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={() => {\n        onClose();\n        resetForm();\n      }}\n      title={\n        mode === \'login\'\n          ? \'Platform Authentication\'\n          : mode === \'register\'\n          ? \'Create Enterprise Account\'\n          : \'Reset Account Password\'\n      }\n      subtitle={\n        mode === \'login\'\n          ? \'Sign in to access your assigned deliverables, projects, and risk metrics.\'\n          : mode === \'register\'\n          ? \'Register a new team workspace identity with SQLite persistence.\'\n          : \'Set a new password for your registered corporate account.\'\n      }\n    >\n      <div className=\"space-y-4\">\n        {/* Tab switchers */}\n        <div className=\"flex border-b border-slate-200\">\n          <button\n            type=\"button\"\n            onClick={() => {"
