            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // 4. Tasks due within 3 days approaching deadline that are not completed"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const approachingTasks = projectTasks.filter(t => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (t.status === \'Done\' || !t.dueDate) return false;"
