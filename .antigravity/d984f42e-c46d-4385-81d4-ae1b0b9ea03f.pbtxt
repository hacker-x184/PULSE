      create_file {
        instruction: "import React from \'react\';\nimport { ShieldCheck, Check, X, Info } from \'lucide-react\';\nimport { Modal } from \'../common/Modal\';\n\ninterface RolePermissionsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const RolePermissionsModal: React.FC<RolePermissionsModalProps> = ({ isOpen, onClose }) => {\n  const permissions = [\n    { capability: \'Create & Edit Projects\', admin: true, manager: true, member: false },\n    { capability: \'Archive & Delete Projects\', admin: true, manager: false, member: false },\n    { capability: \'Create & Assign Deliverable Tasks\', admin: true, manager: true, member: true },\n    { capability: \'Change Task Status & Story Points\', admin: true, manager: true, member: true },\n    { capability: \'Approve Task Architecture Reviews\', admin: true, manager: true, member: false },\n    { capability: \'Manage Team Member Directory & Capacities\', admin: true, manager: true, member: false },\n    { capability: \'Resolve Contribution Score Disputes\', admin: true, manager: true, member: false },\n    { capability: \'Execute Smart Task Redistribution\', admin: true, manager: true, member: false },\n    { capability: \'Run What-If Project Recovery Simulations\', admin: true, manager: true, member: true },\n    { capability: \'Configure Custom Contribution Weights\', admin: true, manager: false, member: false },\n    { capability: \'Connect GitHub Repositories & Sync Commits\', admin: true, manager: true, member: true },\n    { capability: \'Export RFC 4180 CSV & Calendar (.ics)\', admin: true, manager: true, member: true },\n    { capability: \'Download Full Database Backup Snapshot\', admin: true, manager: false, member: false },\n    { capability: \'Reset Demo Database to Initial Fixtures\', admin: true, manager: false, member: false },\n  ];\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={onClose}\n      title=\"Role-Based Access Control (RBAC) Matrix\"\n      subtitle=\"Comprehensive permission capabilities enforced across Admin, Manager, and Member tiers.\"\n    >\n      <div className=\"space-y-4\">\n        <div className=\"p-3 bg-blue-50 border border-blue-200 rounded-xl flex items-start gap-2.5 text-xs text-blue-900\">\n          <Info className=\"w-4 h-4 text-blue-600 shrink-0 mt-0.5\" />\n          <span>\n            Equinox enforces enterprise role-based security. All audit events track actor identity with timestamped database logging.\n          </span>\n        </div>\n\n        <div className=\"border border-slate-200 rounded-xl overflow-hidden bg-white text-xs\">\n          <table className=\"w-full text-left divide-y divide-slate-200\">\n            <thead className=\"bg-slate-50 text-slate-700 font-semibold\">\n              <tr>\n                <th className=\"p-3\">Platform Capability</th>\n                <th className=\"p-3 text-center w-24 text-blue-600\">Admin</th>\n                <th className=\"p-3 text-center w-24 text-indigo-600\">Manager</th>\n                <th className=\"p-3 text-center w-24 text-slate-600\">Member</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-slate-700\">\n              {permissions.map((p, idx) => (\n                <tr key={idx} className=\"hover:bg-slate-50/70\">\n                  <td className=\"p-3 font-medium text-slate-900\">{p.capability}</td>\n                  <td className=\"p-3 text-center\">\n                    {p.admin ? (\n                      <Check className=\"w-4 h-4 text-emerald-600 mx-auto\" />\n                    ) : (\n                      <X className=\"w-4 h-4 text-slate-300 mx-auto\" />\n                    )}\n                  </td>\n                  <td className=\"p-3 text-center\">\n                    {p.manager ? (\n                      <Check className=\"w-4 h-4 text-emerald-600 mx-auto\" />\n                    ) : (\n                      <X className=\"w-4 h-4 text-slate-300 mx-auto\" />\n                    )}\n                  </td>\n                  <td className=\"p-3 text-center\">\n                    {p.member ? (\n                      <Check className=\"w-4 h-4 text-emerald-600 mx-auto\" />\n                    ) : (\n                      <X className=\"w-4 h-4 text-slate-300 mx-auto\" />\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        <div className=\"pt-3 border-t border-slate-100 flex justify-end\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-4 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors\"\n          >\n            Close Matrix\n          </button>\n        </div>\n      </div>\n    </Modal>\n  );\n};\n"
