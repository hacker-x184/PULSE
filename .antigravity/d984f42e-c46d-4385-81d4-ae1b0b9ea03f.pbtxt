rate actionable reports.\" />\n    <meta property=\"og:title\" content=\"Intelligent Project Management & Team Contribution Platform\" />\n    <meta property=\"og:description\" content=\"Manage projects, assign tasks, track progress, analyze team member contributions, identify project risks with transparent rules, and generate actionable reports.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Intelligent Project Management & Team Contribution Platform\",\n  \"description\": \"Manage projects, assign tasks, track progress, analyze team member contributions, identify project risks with transparent rules, and generate actionable reports.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"]\n}\n\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect, useCallback } from \'react\';\nimport { Sidebar, ActivePage } from \'./components/layout/Sidebar\';\nimport { TopBar } from \'./components/layout/TopBar\';\nimport { DashboardPage } from \'./components/dashboard/DashboardPage\';\nimport { ProjectsPage } from \'./components/projects/ProjectsPage\';\nimport { TasksPage } from \'./components/tasks/TasksPage\';\nimport { TeamPage } from \'./components/team/TeamPage\';\nimport { ContributionsPage } from \'./components/contributions/ContributionsPage\';\nimport { RisksPage } from \'./components/risks/RisksPage\';\nimport { ReportsPage } from \'./components/reports/ReportsPage\';\nimport { SettingsPage } from \'./components/settings/SettingsPage\';\nimport { AIAssistantDrawer } from \'./components/ai/AIAssistantDrawer\';\nimport { Modal } from \'./components/common/Modal\';\nimport { AuthModal } from \'./components/auth/AuthModal\';\nimport { MemberGitHubModal } from \'./components/github/MemberGitHubModal\';\nimport { ProjectLeaderModal } from \'./components/projects/ProjectLeaderModal\';\nimport { api } from \'./api/client\';\nimport {\n  Project,\n  Task,\n  TeamMember,\n  DashboardMetrics,\n  MemberContribution,\n  ProjectRisk,\n  TaskPriority,\n  TaskStatus,\n  User\n} from \'./types\';\nimport { AlertCircle, CheckCircle2 } from \'lucide-react\';\n\nexport default function App() {\n  const [activePage, setActivePage] = useState<ActivePage>(\'dashboard\');\n  const [selectedProjectId, setSelectedProjectId] = useState<string>(\'\');\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [isAIOpen, setIsAIOpen] = useState(false);\n  const [isQuickCreateTaskOpen, setIsQuickCreateTaskOpen] = useState(false);\n\n  // Per-member GitHub & Project Leader Modals\n  const [isGitHubModalOpen, setIsGitHubModalOpen] = useState(false);\n  const [isLeaderModalOpen, setIsLeaderModalOpen] = useState(false);\n\n  // Authentication State\n  const [currentUser, setCurrentUser] = useState<User | null>(null);\n  const [isAuthModalOpen, setIsAuthModalOpen] = useState(false);\n  const [authModalMode, setAuthModalMode] = useState<\'login\' | \'register\'>(\'login\');\n\n  // Application Data States\n  const [projects, setProjects] = useState<Project[]>([]);\n  const [tasks, setTasks] = useState<Task[]>([]);\n  const [team, setTeam] = useState<TeamMember[]>([]);\n  const [metrics, setMetrics] = useState<DashboardMetrics | null>(null);\n  const [contributions, setContributions] = useState<MemberContribution[]>([]);\n  const [risks, setRisks] = useState<ProjectRisk[]>([]);\n\n  const [isLoading, setIsLoading] = useState(true);\n  const [isReseeding, setIsReseeding] = useState(false);\n  const [globalError, setGlobalError] = useState<string | null>(null);\n  const [oauthNotice, setOauthNotice] = useState<string | null>(null);\n\n  // Check for GitHub OAuth callback query param\n  useEffect(() => {\n    try {\n      const params = new URLSearchParams(window.location.search);\n      if (params.get(\'github_oauth\') === \'connected\') {\n        setOauthNotice(\'GitHub account successfully authenticated & synchronized with your user profile!\');\n        window.history.replaceState({}, \'\', window.location.pathname);\n        setTimeout(() => setOauthNotice(null), 6000);\n      }\n    } catch {\n      // Ignore URL errors\n    }\n  }, []);\n\n  // Quick Task Modal form fields\n  const [quickTitle, setQuickTitle] = useState(\'\');\n  const [quickDescription, setQuickDescription] = useState(\'\');\n  const [quickProjectId, setQuickProjectId] = useState(\'\');\n  const [quickPriority, setQuickPriority] = useState<TaskPriority>(\'Medium\');\n  const [quickStatus, setQuickStatus] = useState<TaskStatus>(\'To Do\');\n  const [quickDueDate, setQuickDueDate] = useState(\'\');\n  const [quickAssigneeId, setQuickAssigneeId] = useState(\'\');\n\n  // Primary data loader\n  const loadAllData = useCallback(async () => {\n    try {\n      setGlobalError(null);\n      const [pRes, tRes, tmRes, mRes, cRes, rRes, meRes] = await Promise.all([\n        api.getProjects(),\n        api.getTasks(),\n        api.getTeam(),\n        api.getDashboard(selectedProjectId || undefined),\n        api.getContributions(selectedProjectId || undefined),\n        api.getRisks(selectedProjectId || undefined),\n        api.getMe().catch(() => ({ user: null }))\n      ]);\n\n      setProjects(pRes);\n      setTasks(tRes);\n      setTeam(tmRes);\n      setMetrics(mRes);\n      setContributions(cRes);\n      setRisks(rRes);\n      if (meRes?.user) {\n        setCurrentUser(meRes.user);\n      }\n    } catch (err: any) {\n      console.error(\'Failed to load application data:\', err);\n      setGlobalError(err.message || \'Error loading platform records.\');\n    } finally {\n      setIsLoading(false);\n    }\n  }, [selectedProjectId]);\n\n  useEffect(() => {\n    loadAllData();\n  }, [loadAllData]);\n\n  // Auth Actions\n  const handleAuthSuccess = (user: User) => {\n    setCurrentUser(user);\n    loadAllData();\n  };\n\n  const handleLogout = () => {\n    api.logout();\n    setCurrentUser(null);\n    setIsAuthModalOpen(true);\n    setAuthModalMode(\'login\');\n  };\n\n  const handleOpenAuth = (mode: \'login\' | \'register\' = \'login\') => {\n    setAuthModalMode(mode);\n    setIsAuthModalOpen(true);\n  };\n\n  // Project Actions\n  const handleCreateProject = async (data: Partial<Project>) => {\n    await api.createProject(data);\n    await loadAllData();\n  };\n\n  const handleUpdateProject = async (id: string, data: Partial<Project>) => {\n    await api.updateProject(id, data);\n    await loadAllData();\n  };\n\n  const handleDeleteProject = async (id: string) => {\n    await api.deleteProject(id);\n    if (selectedProjectId === id) {\n      setSelectedProjectId(\'\');\n    }\n    await loadAllData();\n  };\n\n  // Task Actions\n  const handleCreateTask = async (data: Partial<Task>) => {\n    await api.createTask(data);\n    await loadAllData();\n  };\n\n  const handleUpdateTask = async (id: string, data: Partial<Task>) => {\n    await api.updateTask(id, data);\n    await loadAllData();\n  };\n\n  const handleDeleteTask = async (id: string) => {\n    await api.deleteTask(id);\n    await loadAllData();\n  };\n\n  // Team Actions\n  const handleCreateMember = async (data: Partial<TeamMember>) => {\n    await api.createTeamMember(data);\n    await loadAllData();\n  };\n\n  const handleUpdateMember = async (id: string, data: Partial<TeamMember>) => {\n    await api.updateTeamMember(id, data);\n    await loadAllData();\n  };\n\n  const handleDeleteMember = async (id: string) => {\n    await api.deleteTeamMember(id);\n    await loadAllData();\n  };\n\n  // Reseed DB action\n  const handleReseedData = async () => {\n    setIsReseeding(true);\n    try {\n      await api.resetAndSeedData();\n      await loadAllData();\n    } catch (err: any) {\n      alert(`Failed to reset database: ${err.message}`);\n    } finally {\n      setIsReseeding(false);\n    }\n  };\n\n  // Quick Task Submit\n... (truncated)\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #f8fafc;\n    color: #0f172a;\n    -webkit-font-smoothing: antialiased;\n    margin: 0;\n    padding: 0;\n  }\n\n  code, pre, .font-mono, .tabular-nums {\n    font-family: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\n    font-variant-numeric: tabular-nums;\n  }\n}\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(<App />);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"types\": [\"vite/client\"],\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  },\n  \"exclude\": [\"dist\"]\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      allowedHosts: true as true,\n      host: \'0.0.0.0\',\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\342\200\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
    }
  }
}
