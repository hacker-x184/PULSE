    content: "      {/* Header & View Switcher */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2\">\n            <span>Atlassian Jira Agile Board</span>\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            Active sprints, drag-and-drop workflow lanes, story points, and real GitHub dev commits.\n          </p>\n        </div>\n\n        {/* View Mode Switcher: Board, Backlog & Sprints, Table */}\n        <div className=\"flex items-center p-0.5 bg-slate-100 rounded-lg border border-slate-200\">\n          <button\n            type=\"button\"\n            onClick={() => setViewMode(\'kanban\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md transition-colors ${\n              viewMode === \'kanban\'\n                ? \'bg-white text-slate-900 shadow-2xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Kanban className=\"w-3.5 h-3.5\" />\n            <span>Active Sprint Board</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setViewMode(\'backlog\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md transition-colors ${\n              viewMode === \'backlog\'\n                ? \'bg-white text-slate-900 shadow-2xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <Layers className=\"w-3.5 h-3.5\" />\n            <span>Backlog & Sprints</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setViewMode(\'list\')}\n            className={`flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md transition-colors ${\n              viewMode === \'list\'\n                ? \'bg-white text-slate-900 shadow-2xs\'\n                : \'text-slate-600 hover:text-slate-900\'\n            }`}\n          >\n            <ListIcon className=\"w-3.5 h-3.5\" />\n            <span>Table</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white p-3 rounded-xl border border-slate-200 shadow-2xs space-y-3\">\n        <div className=\"flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3\">\n          {/* Search */}\n          <div className=\"relative flex-1\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input\n              type=\"text\"\n              value={searchTerm}"
