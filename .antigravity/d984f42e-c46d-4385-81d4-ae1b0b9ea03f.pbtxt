            }
            lines {
              text: "): RedistributionSuggestion[] {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const pendingTasks = tasks.filter(t => t.status !== \'Done\' && t.assignee_id);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  "
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  // Calculate task counts per member"
