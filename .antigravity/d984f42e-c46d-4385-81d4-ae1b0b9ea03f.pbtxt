      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col antialiased\">\n      {/* Left Sidebar */}\n      <Sidebar\n        activePage={activePage}\n        onNavigate={setActivePage}\n        onOpenAI={() => setIsAIOpen(true)}\n        onReseedData={handleReseedData}\n        isReseeding={isReseeding}\n        mobileOpen={mobileMenuOpen}\n        onCloseMobile={() => setMobileMenuOpen(false)}\n        currentUser={currentUser}\n        onOpenAuth={handleOpenAuth}\n        onOpenProfile={() => setIsProfileModalOpen(true)}\n        onCreateTask={() => {\n          setQuickProjectId(selectedProjectId || (projects[0]?.id ?? \'\'));\n          setIsQuickCreateTaskOpen(true);\n        }}\n      />\n\n      {/* Main Workspace Frame (offset for md sidebar) */}\n      <div className=\"md:pl-64 flex flex-col flex-1 min-w-0\">\n        {/* Top Header */}\n        <TopBar\n          projects={projects}\n          selectedProjectId={selectedProjectId}\n          onSelectProject={setSelectedProjectId}\n          onOpenMobileMenu={() => setMobileMenuOpen(true)}\n          onOpenAI={() => setIsAIOpen(true)}\n          onCreateTask={() => {\n            setQuickProjectId(selectedProjectId || (projects[0]?.id ?? \'\'));\n            setIsQuickCreateTaskOpen(true);\n          }}\n          currentUser={currentUser}\n          onOpenAuth={handleOpenAuth}\n          onLogout={handleLogout}\n          onOpenGitHub={() => setIsGitHubModalOpen(true)}\n          onOpenLeaderModal={() => setIsLeaderModalOpen(true)}\n          onOpenProfile={() => setIsProfileModalOpen(true)}\n          onOpenInvitations={() => setIsInvitationsModalOpen(true)}\n          onOpenRolePermissions={() => setIsPermissionsModalOpen(true)}\n        />"
        replacement_content: "  // Show Front / Landing Page when user starts website (if not logged in) or after logging out\n  if (!currentUser && !isGuestPreview) {\n    return (\n      <div className=\"min-h-screen bg-slate-50 text-slate-900 font-sans\">\n        <FrontPage\n          onOpenAuth={handleOpenAuth}\n          onExploreDemo={() => setIsGuestPreview(true)}\n        />\n\n        {/* Global Authentication Modal triggered from Front Page buttons */}\n        <AuthModal\n          isOpen={isAuthModalOpen}\n          onClose={() => setIsAuthModalOpen(false)}\n          onAuthSuccess={handleAuthSuccess}\n          initialMode={authModalMode}\n        />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col antialiased\">\n      {/* Left Sidebar */}\n      <Sidebar\n        activePage={activePage}\n        onNavigate={setActivePage}\n        onOpenAI={() => setIsAIOpen(true)}\n        onReseedData={handleReseedData}\n        isReseeding={isReseeding}\n        mobileOpen={mobileMenuOpen}\n        onCloseMobile={() => setMobileMenuOpen(false)}\n        currentUser={currentUser}\n        onOpenAuth={handleOpenAuth}\n        onOpenProfile={() => setIsProfileModalOpen(true)}\n        onCreateTask={() => {\n          setQuickProjectId(selectedProjectId || (projects[0]?.id ?? \'\'));\n          setIsQuickCreateTaskOpen(true);\n        }}\n        onOpenFrontPage={() => setIsGuestPreview(false)}\n      />\n\n      {/* Main Workspace Frame (offset for md sidebar) */}\n      <div className=\"md:pl-64 flex flex-col flex-1 min-w-0\">\n        {/* Top Header */}\n        <TopBar\n          projects={projects}\n          selectedProjectId={selectedProjectId}\n          onSelectProject={setSelectedProjectId}\n          onOpenMobileMenu={() => setMobileMenuOpen(true)}\n          onOpenAI={() => setIsAIOpen(true)}\n          onCreateTask={() => {\n            setQuickProjectId(selectedProjectId || (projects[0]?.id ?? \'\'));\n            setIsQuickCreateTaskOpen(true);\n          }}\n          currentUser={currentUser}\n          onOpenAuth={handleOpenAuth}\n          onLogout={handleLogout}\n          onOpenGitHub={() => setIsGitHubModalOpen(true)}\n          onOpenLeaderModal={() => setIsLeaderModalOpen(true)}\n          onOpenProfile={() => setIsProfileModalOpen(true)}\n          onOpenInvitations={() => setIsInvitationsModalOpen(true)}\n          onOpenRolePermissions={() => setIsPermissionsModalOpen(true)}\n          onOpenFrontPage={() => setIsGuestPreview(false)}\n          isGuestPreview={isGuestPreview}\n        />"
        start_line: 240
        end_line: 283
      }
      num_matches: 1
    }
    description: "Render FrontPage when not authenticated and pass onOpenFrontPage to Sidebar and TopBar"
