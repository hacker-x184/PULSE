  view_file {
    absolute_path_uri: "file:///src/components/settings/SettingsPage.tsx"
    start_line: 809
    end_line: 859
    content: "            <h2 className=\"text-sm font-bold text-slate-900\">Role-Based Access Control (RBAC) Permissions Matrix</h2>\n            <p className=\"text-xs text-slate-500\">Security enforcement capabilities across platform roles.</p>\n          </div>\n\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left border-collapse text-xs\">\n              <thead>\n                <tr className=\"border-b border-slate-200 bg-slate-50 text-[11px] font-semibold text-slate-500 uppercase tracking-wider\">\n                  <th className=\"py-3 px-4\">Platform Capability / Action</th>\n                  <th className=\"py-3 px-4 text-center\">Admin</th>\n                  <th className=\"py-3 px-4 text-center\">Manager</th>\n                  <th className=\"py-3 px-4 text-center\">Member</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-100\">\n                {rbacMatrix.map((item, idx) => (\n                  <tr key={idx} className=\"hover:bg-slate-50/70 transition-colors\">\n                    <td className=\"py-2.5 px-4 font-medium text-slate-900\">\n                      {item.capability}\n                    </td>\n                    <td className=\"py-2.5 px-4 text-center\">\n                      {item.admin ? (\n                        <Check className=\"w-4 h-4 text-emerald-600 mx-auto\" />\n                      ) : (\n                        <X className=\"w-4 h-4 text-slate-300 mx-auto\" />\n                      )}\n                    </td>\n                    <td className=\"py-2.5 px-4 text-center\">\n                      {item.manager ? (\n                        <Check className=\"w-4 h-4 text-emerald-600 mx-auto\" />\n                      ) : (\n                        <X className=\"w-4 h-4 text-slate-300 mx-auto\" />\n                      )}\n                    </td>\n                    <td className=\"py-2.5 px-4 text-center\">\n                      {item.member ? (\n                        <Check className=\"w-4 h-4 text-emerald-600 mx-auto\" />\n                      ) : (\n                        <X className=\"w-4 h-4 text-slate-300 mx-auto\" />\n                      )}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};"
    num_lines: 861
    num_bytes: 37954
    line_range_bytes: 2325
  }
}
