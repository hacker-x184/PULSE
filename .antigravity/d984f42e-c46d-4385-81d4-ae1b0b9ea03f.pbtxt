      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add GET /api/team/work-status in server.ts\", \"EndLine\":1679, \"Instruction\":\"Add work-status tracking endpoint for team members\", \"ReplacementContent\":\"    res.json(results);\\n  });\\n\\n  // Team Member Work Status Tracking Endpoint (For Team Leaders & Members)\\n  app.get(\'/api/team/work-status\', (req, res) => {\\n    const { project_id } = req.query as { project_id?: string };\\n    let memberSql = \'SELECT * FROM team_members\';\\n    if (project_id) {\\n      memberSql = `SELECT tm.* FROM team_members tm \\n                   JOIN project_members pm ON tm.id = pm.member_id \\n                   WHERE pm.project_id = ?`;\\n    }\\n    const members = queryAll(memberSql, project_id ? [project_id] : []);\\n\\n    let tasksSql = \'SELECT * FROM tasks\';\\n    if (project_id) {\\n      tasksSql += \' WHERE project_id = ?\';\\n    }\\n    const allTasks = queryAll(tasksSql, project_id ? [project_id] : []);\\n\\n    const memberStatusOverview = members.map(m => {\\n      const assignedTasks = allTasks.filter(t => t.assignee_id === m.id);\\n      const totalAssigned = assignedTasks.length;\\n      const notStarted = assignedTasks.filter(t => t.status === \'Not Started\' || t.status === \'To Do\').length;\\n      const inProgress = assignedTasks.filter(t => t.status === \'In Progress\' || t.status === \'In Review\').length;\\n      const completed = assignedTasks.filter(t => t.status === \'Completed\' || t.status === \'Done\').length;\\n      const progress = totalAssigned > 0 ? Math.round((completed / totalAssigned) * 100) : 0;\\n\\n      return {\\n        member_id: m.id,\\n        name: m.name,\\n        email: m.email,\\n        role: m.role,\\n        avatar_url: m.avatar_url,\\n        github_username: m.github_username,\\n        total_assigned: totalAssigned,\\n        not_started_count: notStarted,\\n        in_progress_count: inProgress,\\n        completed_count: completed,\\n    