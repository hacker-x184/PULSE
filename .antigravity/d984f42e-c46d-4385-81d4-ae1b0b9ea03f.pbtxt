    content: "  );\n\n  // Seed Meeting Notes\n  execute(\n    `INSERT INTO meeting_notes (id, project_id, title, meeting_date, attendees, content, action_items, created_at) VALUES\n    (\'mn-1\', p1Id, \'Sprint 1 Architecture Sync & Blocker Review\', ?, \'Zaid Tested, Elena Rostova, Marcus Vance\', \'Reviewed idempotency key benchmarks and zero-trust IAM scope boundaries. Discussed distributed lock contention.\', \'1. Marcus to benchmark WAL pragma\\n2. Elena to review IAM matrix\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  // Seed Retrospective\n  execute(\n    `INSERT INTO retrospectives (id, project_id, sprint, went_well, needs_improvement, action_items, created_at) VALUES\n    (\'retro-1\', p1Id, \'Sprint 1 (Active)\', \'Fast CI feedback on PRs, clear Jira issue key convention, real GitHub sync.\', \'Unclear estimation on distributed locks, need earlier QA involvement.\', \'1. Add acceptance criteria checklist before moving to In Progress\\n2. Standardize 30-min architecture sign-off\', ?)`,\n    [now.toISOString()]\n  );\n\n  // Seed Audit Logs\n  execute(\n    `INSERT INTO audit_logs (id, project_id, entity_type, entity_id, action, actor_name, details, created_at) VALUES\n    (\'log-1\', p1Id, \'Project\', p1Id, \'Created Project\', \'Zaid Tested\', \'Initialized Core Financial Ledger Modernization with key EQX\', ?),\n    (\'log-2\', p1Id, \'Task\', \'t-101\', \'Status Changed to Done\', \'Elena Rostova\', \'Completed idempotency key partition scheme with verified commits\', ?)`,\n    [now.toISOString(), now.toISOString()]\n  );\n\n  // Seed Notifications\n  execute(\n    `INSERT INTO notifications (id, user_id, title, message, type, link, is_read, created_at) VALUES\n    (\'notif-1\', \'u-zaid\', \'Task Review Requested\', \'Marcus Vance submitted EQX-102 for architectural sign-off.\', \'review\', \'/tasks\', 0, ?),\n    (\'notif-2\', \'u-zaid\', \'Milestone Deadline Alert\', \'PORT-201 Customer Portal & Analytics Dashboard is due tomorrow.\', \'milestone\', \'/tasks\', 0, ?)`,\n    [now.toISOString(), now.toISOString()]\n  );\n\n  // Seed Discussions\n  execute(\n    `INSERT INTO discussions (id, project_id, author_id, author_name, author_avatar, category, title, content, created_at) VALUES\n    (\'disc-1\', p1Id, \'u-zaid\', \'Zaid Tested\', \'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150\', \'Architecture\', \'SQLite WAL Mode concurrency and lock timeouts\', \'We benchmarked WAL pragma with 100 concurrent writers. Latency p99 remained under 12ms. Zero lock starvation observed.\', ?),\n    (\'disc-2\', p1Id, \'u-elena\', \'Elena Rostova\', \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150\', \'Sprint Planning\', \'Sprint 2 Scope & Zero-Trust IAM Federation\', \'Proposal to prioritize OAuth scope authorization over raw Redis caching. Please review the specification draft.\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  // Seed Peer Kudos (Invisible Work recognition)\n  execute(\n    `INSERT INTO peer_kudos (id, project_id, from_name, to_member_id, category, message, created_at) VALUES\n    (\'kd-1\', p1Id, \'Elena Rostova\', m2Id, \'Unblocking Teammates\', \'Huge thanks to Marcus for triaging the distributed lock deadlock under load. Saved the release sprint!\', ?),\n    (\'kd-2\', p1Id, \'Marcus Vance\', m4Id, \'Mentorship & Support\', \'Devon walked the team through the CI linting setup and container configuration. Excellent guidance.\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  // Seed Task Attachments\n  execute(\n    `INSERT INTO task_attachments (id, task_id, file_name, file_size, file_type, uploaded_by, created_at) VALUES\n    (\'att-1\', \'t-101\', \'idempotency-key-partition-spec.pdf\', \'245 KB\', \'application/pdf\', \'Elena Rostova\', ?),\n    (\'att-2\', \'t-102\', \'sqlite-wal-benchmark-results.csv\', \'38 KB\', \'text/csv\', \'Marcus Vance\', ?)`,\n    [dYesterday, now.toISOString()]\n  );\n\n  saveDatabase();\n}\n\nasync function startServer() {\n  await initDatabase();\n\n  const app = express();\n  app.use(express.json());\n\n  // CORS headers"
