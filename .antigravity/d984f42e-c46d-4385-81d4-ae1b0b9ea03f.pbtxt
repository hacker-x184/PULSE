    content: "              <div className=\"px-4 py-2.5\">\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <ShieldCheck className=\"w-4 h-4 text-blue-600 shrink-0\" />\n                  <span className=\"text-xs font-bold text-slate-900\">Signed In</span>\n                </div>\n                <div className=\"text-xs font-semibold text-slate-800\">{displayName}</div>\n                <div className=\"text-[11px] text-slate-500 font-mono truncate\">{displayEmail}</div>\n                <div className=\"mt-1.5 flex items-center gap-1.5\">\n                  <span className=\"inline-block text-[10px] font-semibold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200\">\n                    {displayRole}\n                  </span>\n                  <span className=\"inline-block text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200\">\n                    Admin Access\n                  </span>\n                </div>\n              </div>\n\n              {/* Profile & Identity Settings */}\n              <div className=\"px-2 py-1.5 space-y-0.5\">\n                {onOpenProfile && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n                      onOpenProfile();\n                    }}\n                    className=\"w-full flex items-center gap-2.5 px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-lg transition-colors text-left\"\n                  >\n                    <UserIcon className=\"w-3.5 h-3.5 text-blue-600\" />\n                    <span>My Profile & Credentials</span>\n                  </button>\n                )}\n\n                {onOpenInvitations && (\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setIsUserMenuOpen(false);\n