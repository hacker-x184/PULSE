    start_line: 3449
    end_line: 3506
    content: "Never invent tasks, team members, or deadlines.\nIf information is not present, clearly state that the data is not available.\nDo not delete records. Be clear, professional, and actionable.`;\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.8-flash\',\n        contents: `${systemInstruction}\\n\\n${contextText}\\n\\nUser Question: ${prompt}`\n      });\n\n      res.json({\n        has_api_key: true,\n        response: response.text || \'No response generated.\',\n        grounding_data_points: projects.length + tasks.length + members.length,\n        sources_used: [`Projects (${projects.length})`, `Tasks (${tasks.length})`, `Members (${members.length})`]\n      });\n    } catch (err: any) {\n      let friendlyMsg = err.message || \'Unknown error contacting AI model.\';\n      if (friendlyMsg.includes(\'PERMISSION_DENIED\') || friendlyMsg.includes(\'403\')) {\n        friendlyMsg = \'AI Assistant noticed: The current API key does not have permission or quota for Gemini. Core platform operations (Projects, Tasks, Team, Contributions, Risks, CSV Reports) continue to function independently.\';\n      }\n      res.json({\n        has_api_key: true,\n        response: friendlyMsg,\n        grounding_data_points: 0,\n        sources_used: []\n      });\n    }\n  });\n\n  // Frontend mounting: Vite in development, static in production\n  if (!isProd) {\n    const { createServer: createViteServer } = await import(\'vite\');\n    const vite = await createViteServer({\n      server: {\n        middlewareMode: true,\n        allowedHosts: true\n      },\n      appType: \'spa\'\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.resolve(__dirname, \'dist\')));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.resolve(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Intelligent PM Platform server running on http://0.0.0.0:${PORT}`);\n    console.log(`SQLite database file: ${DB_FILE}`);\n  });\n}\n\nstartServer().catch(err => {\n  console.error(\'Failed to start server:\', err);\n  process.exit(1);\n});\n"
    num_lines: 3507
    num_bytes: 149027
    line_range_bytes: 2084
  }
}
