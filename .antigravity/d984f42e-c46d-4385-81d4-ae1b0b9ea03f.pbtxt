ber) => {\n    setName(m.name);\n    setEmail(m.email);\n    setRole(m.role);\n    setGithubUsername(m.github_username || \'\');\n    setSelectedProjectIds(m.assigned_project_ids || []);\n    setFormError(null);\n    setEditingMember(m);\n  };\n\n  const handleSaveMember = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim()) {"
