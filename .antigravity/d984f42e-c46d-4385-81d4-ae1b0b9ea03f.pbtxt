      original_chunk {
        target_content: "  LogIn,\n  Activity,\n  FileCode,\n  ExternalLink\n} from \'lucide-react\';\nimport { User } from \'../../types\';\n\nexport type ActivePage =\n  | \'dashboard\'\n  | \'projects\'\n  | \'tasks\'\n  | \'team\'\n  | \'collaboration\'\n  | \'simulation\'\n  | \'contributions\'\n  | \'risks\'\n  | \'reports\'\n  | \'settings\';\n\ninterface SidebarProps {\n  activePage: ActivePage;\n  onNavigate: (page: ActivePage) => void;\n  onOpenAI: () => void;\n  onReseedData: () => void;\n  isReseeding: boolean;\n  mobileOpen: boolean;\n  onCloseMobile: () => void;\n  currentUser: User | null;\n  onOpenAuth: (mode?: \'login\' | \'register\') => void;\n  onOpenProfile?: () => void;\n  onCreateTask: () => void;\n  onCreateProject?: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activePage,\n  onNavigate,\n  onOpenAI,\n  onReseedData,\n  isReseeding,\n  mobileOpen,\n  onCloseMobile,\n  currentUser,\n  onOpenAuth,\n  onCreateTask,\n  onCreateProject\n}) => {\n  const [isPlatformMenuOpen, setIsPlatformMenuOpen] = useState(false);\n  const [activeWorkspace, setActiveWorkspace] = useState(\'Equinox Enterprise Org\');\n  const [showHealthModal, setShowHealthModal] = useState(false);\n  const [healthData, setHealthData] = useState<any>(null);\n\n  const menuRef = useRef<HTMLDivElement>(null);\n\n  const workspaces = [\n    { id: \'ws-main\', name: \'Equinox Enterprise Org\', role: \'Primary Production\' },\n    { id: \'ws-fintech\', name: \'Fintech Modernization Division\', role: \'Active Sprints\' },\n    { id: \'ws-platform\', name: \'Core Infrastructure & Reliability\', role: \'Internal Ops\' }\n  ];\n\n  // Close menu when clicking outside\n  useEffect(() => {\n    function handleClickOutside(event: MouseEvent) {\n      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {\n        setIsPlatformMenuOpen(false);\n      }\n    }\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const navItems = [\n    { id: \'dashboard\' as ActivePage, label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'projects\' as ActivePage, label: \'Projects\', icon: FolderKanban },\n    { id: \'tasks\' as ActivePage, label: \'Task Management\', icon: CheckSquare },\n    { id: \'team\' as ActivePage, label: \'Team Management\', icon: Users },\n    { id: \'contributions\' as ActivePage, label: \'Contribution Analysis\', icon: BarChart3 },\n    { id: \'risks\' as ActivePage, label: \'Risk Analysis\', icon: ShieldAlert },\n    { id: \'reports\' as ActivePage, label: \'Reports & Export\', icon: FileText },\n    { id: \'settings\' as ActivePage, label: \'Settings\', icon: Settings },\n  ];"
        replacement_content: "  LogIn,\n  Activity,\n  FileCode,\n  ExternalLink,\n  MessageSquare,\n  Sliders\n} from \'lucide-react\';\nimport { User } from \'../../types\';\n\nexport type ActivePage =\n  | \'dashboard\'\n  | \'projects\'\n  | \'tasks\'\n  | \'team\'\n  | \'collaboration\'\n  | \'simulation\'\n  | \'contributions\'\n  | \'risks\'\n  | \'reports\'\n  | \'settings\';\n\ninterface SidebarProps {\n  activePage: ActivePage;\n  onNavigate: (page: ActivePage) => void;\n  onOpenAI: () => void;\n  onReseedData: () => void;\n  isReseeding: boolean;\n  mobileOpen: boolean;\n  onCloseMobile: () => void;\n  currentUser: User | null;\n  onOpenAuth: (mode?: \'login\' | \'register\') => void;\n  onOpenProfile?: () => void;\n  onCreateTask: () => void;\n  onCreateProject?: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activePage,\n  onNavigate,\n  onOpenAI,\n  onReseedData,\n  isReseeding,\n  mobileOpen,\n  onCloseMobile,\n  currentUser,\n  onOpenAuth,\n  onOpenProfile,\n  onCreateTask,\n  onCreateProject\n}) => {\n  const [isPlatformMenuOpen, setIsPlatformMenuOpen] = useState(false);\n  const [activeWorkspace, setActiveWorkspace] = useState(\'Equinox Enterprise Org\');\n  const [showHealthModal, setShowHealthModal] = useState(false);\n  const [healthData, setHealthData] = useState<any>(null);\n\n  const menuRef = useRef<HTMLDivElement>(null);\n\n  const workspaces = [\n    { id: \'ws-main\', name: \'Equinox Enterprise Org\', role: \'Primary Production\' },\n    { id: \'ws-fintech\', name: \'Fintech Modernization Division\', role: \'Active Sprints\' },\n    { id: \'ws-platform\', name: \'Core Infrastructure & Reliability\', role: \'Internal Ops\' }\n  ];\n\n  // Close menu when clicking outside\n  useEffect(() => {\n    function handleClickOutside(event: MouseEvent) {\n      if (menuRef.current && !menuRef.current.contains(event.target as Node)) {\n        setIsPlatformMenuOpen(false);\n      }\n    }\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const navItems = [\n    { id: \'dashboard\' as ActivePage, label: \'Dashboard\', icon: LayoutDashboard },\n    { id: \'projects\' as ActivePage, label: \'Projects\', icon: FolderKanban },\n    { id: \'tasks\' as ActivePage, label: \'Task Management\', icon: CheckSquare },\n    { id: \'team\' as ActivePage, label: \'Team Directory\', icon: Users },\n    { id: \'collaboration\' as ActivePage, label: \'Collaboration & Comms\', icon: MessageSquare },\n    { id: \'simulation\' as ActivePage, label: \'Simulation & Recovery\', icon: Sliders },\n    { id: \'contributions\' as ActivePage, label: \'Contribution Analysis\', icon: BarChart3 },\n    { id: \'risks\' as ActivePage, label: \'Risk Analysis\', icon: ShieldAlert },\n    { id: \'reports\' as ActivePage, label: \'Reports & Export\', icon: FileText },\n    { id: \'settings\' as ActivePage, label: \'Settings\', icon: Settings },\n  ];"
