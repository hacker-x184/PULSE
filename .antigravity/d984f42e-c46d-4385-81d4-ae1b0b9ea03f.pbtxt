  view_file {
    absolute_path_uri: "file:///server.ts"
    start_line: 3419
    end_line: 3444
    content: "    const tFilter = project_id ? \' WHERE project_id = ?\' : \'\';\n    const tasks = queryAll<TaskRecord>(\'SELECT * FROM tasks\' + tFilter, project_id ? [project_id] : []);\n    const members = queryAll(\'SELECT * FROM team_members\');\n\n    // Context string strictly from database\n    const lines = [\'ACTUAL PROJECT DATABASE RECORDS:\'];\n    lines.push(`Projects count: ${projects.length}`);\n    for (const p of projects) {\n      const pTasks = tasks.filter(t => (t as any).project_id === p.id);\n      const done = pTasks.filter(t => t.status === \'Done\').length;\n      lines.push(`- Project \"${p.name}\" (Status: ${p.status}, Deadline: ${p.deadline || \'None\'}): ${pTasks.length} tasks, ${done} completed.`);\n    }\n\n    lines.push(`\\nTeam Members (${members.length}):`);\n    for (const m of members) {\n      const mTasks = tasks.filter(t => (t as any).assignee_id === m.id);\n      lines.push(`- ${m.name} (${m.role}): ${mTasks.length} tasks assigned.`);\n    }\n\n    lines.push(`\\nTasks Summary:`);\n    for (const t of tasks.slice(0, 25)) {\n      lines.push(`- \"${t.title}\" | Priority: ${t.priority} | Status: ${t.status} | Due: ${(t as any).due_date || \'None\'}`);\n    }\n\n    const contextText = lines.join(\'\\n\');\n"
    num_lines: 3507
    num_bytes: 149027
    line_range_bytes: 1202
  }
}
