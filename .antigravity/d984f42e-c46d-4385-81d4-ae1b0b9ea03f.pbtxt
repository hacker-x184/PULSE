    content: "  };\n\n  const handleDisconnect = async () => {\n    if (!ghProjectId) return;\n    if (!confirm(\'Are you sure you want to disconnect this repository and clear cached activity?\')) return;\n    setIsDisconnecting(true);\n    try {\n      await api.disconnectProjectGitHub(ghProjectId);\n      setGhStatus(null);\n      setGhMessage(\'GitHub repository disconnected and cached records removed.\');\n      setAutoUpdatedTasks([]);\n      onRefreshData?.();\n    } catch (err: any) {\n      setGhMessage(`Failed to disconnect: ${err.message}`);\n    } finally {\n      setIsDisconnecting(false);\n    }\n  };\n\n  const copyCommands = () => {\n    const text = `cd backend\\npython3 -m venv venv\\nsource venv/bin/activate\\npip install -r requirements.txt\\npython seed.py\\nuvicorn main:app --reload --port 8000`;\n    navigator.clipboard.writeText(text);\n    setCopiedCmd(true);\n    setTimeout(() => setCopiedCmd(false), 2000);\n  };\n\n  return (\n    <div className=\"p-4 sm:p-6 lg:p-8 space-y-6 max-w-5xl mx-auto\">\n      {/* Header */}\n      <div>\n        <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">\n          System & Integration Settings\n        </h1>\n        <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n          Configure real GitHub API repository integration, auto-task transitions, and inspect platform persistence.\n        </p>\n      </div>\n\n      {/* Database & Demo Baseline */}\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n        <div className=\"flex items-center gap-2 pb-3 border-b border-slate-100\">\n          <Database className=\"w-5 h-5 text-blue-600\" />\n          <div>\n            <h2 className=\"text-sm font-bold text-slate-900\">Database Engine & Persistence</h2>\n            <p className=\"text-xs text-slate-500\">Persistent SQLite storage with foreign key constraints</p>\n          </div>\n        </div>\n\n        <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 p-4 bg-slate-50 rounded-lg border border-slate-200\">\n          <div className=\"space-y-1\">\n            <div className=\"text-xs font-semibold text-slate-800\">\n              Deterministic Demo Data Seeder\n            </div>\n            <div className=\"text-xs text-slate-500 max-w-lg leading-relaxed\">\n              Resets the database and populates 3 projects, 4 team members, and realistic deliverable tasks with varying priorities and deadlines to test all risk invariants.\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={onReseedData}\n            disabled={isReseeding}\n            className=\"px-4 py-2 text-xs font-semibold text-slate-800 hover:text-slate-950 bg-white hover:bg-slate-100 border border-slate-300 rounded-lg shadow-2xs transition-colors shrink-0 flex items-center gap-2 self-start sm:self-auto disabled:opacity-50\"\n          >\n            <RefreshCw className={`w-3.5 h-3.5 ${isReseeding ? \'animate-spin text-blue-600\' : \'\'}`} />\n            <span>{isReseeding ? \'Resetting...\' : \'Reset & Seed Demo DB\'}</span>\n          </button>\n        </div>\n      </div>\n\n      {/* GitHub REST API Integration */}\n      <div className=\"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-4\">\n        <div className=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <Github className=\"w-5 h-5 text-slate-800\" />\n            <div>\n              <h2 className=\"text-sm font-bold text-slate-900\">100% Real GitHub Integration</h2>\n              <p className=\"text-xs text-slate-500\">\n                Sync live commits, pull requests, import GitHub issues as Jira tasks, and automatically transition task workflows.\n              </p>\n            </div>\n          </div>\n\n          {ghStatus?.is_connected && (\n            <span className=\"inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n              Connected: {ghStatus.repo_name}\n            </span>\n          )}\n        </div>\n\n        {/* Auto Updated Tasks Notification */}\n        {autoUpdatedTasks.length > 0 && (\n          <div className=\"p-3 bg-blue-50 border border-blue-200 rounded-lg space-y-1 text-xs\">\n            <div className=\"font-bold text-blue-900 flex items-center gap-1.5\">\n              <CheckCircle2 className=\"w-4 h-4 text-blue-600\" />\n              Auto-Updated {autoUpdatedTasks.length} Jira Task(s) from Git Activity:\n            </div>\n            <div className=\"space-y-1 pl-5\">\n              {autoUpdatedTasks.map((t, idx) => (\n                <div key={idx} className=\"text-blue-800 font-mono text-[11px]\">\n                  <span className=\"font-bold\">[{t.issue_key}]</span>: {t.old_status} &rarr; <span className=\"font-bold\">{t.new_status}</span> ({t.reason})\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        <form onSubmit={handleConnectGitHub} className=\"space-y-4\">\n          {ghMessage && (\n            <div\n              className={`p-3 text-xs rounded-lg border flex items-center gap-2 ${\n                ghStatus?.is_connected\n                  ? \'bg-emerald-50 text-emerald-800 border-emerald-200\'\n                  : \'bg-amber-50 text-amber-800 border-amber-200\'\n              }`}\n            >\n              {ghStatus?.is_connected ? (\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n              ) : (\n                <AlertCircle className=\"w-4 h-4 text-amber-600 shrink-0\" />\n              )}\n              <span>{ghMessage}</span>\n            </div>\n          )}\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Target Project\n              </label>\n              <select\n                value={ghProjectId}\n                onChange={e => setGhProjectId(e.target.value)}\n                className=\"w-full px-3 py-1.5 text-xs text-slate-900 border border-slate-200 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-blue-500\"\n              >\n                {projects.map(p => (\n                  <option key={p.id} value={p.id}>\n                    {p.name} ({p.key_prefix || \'EQX\'})\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Repository Owner or GitHub URL\n              </label>\n              <input\n                type=\"text\"\n                value={repoOwner}\n                onChange={e => handleOwnerChange(e.target.value)}\n                placeholder=\"e.g. facebook, or https://github.com/owner/repo\"\n                className=\"w-full px-3 py-1.5 text-xs text-slate-900 border border-slate-200 rounded-lg focus:outline-hidden focus:ring-2 focus:ring-blue-500 font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Repository Name\n              </label>"
    num_lines: 454
    num_bytes: 19634
    line_range_bytes: 7265
  }
}
