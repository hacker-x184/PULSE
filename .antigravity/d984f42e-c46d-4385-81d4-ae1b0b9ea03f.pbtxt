    content: "          )}\n        </div>\n\n        {/* Primary Action Button */}\n        <button\n          type=\"button\"\n          onClick={onCreateTask}\n          className=\"flex items-center gap-1 px-2.5 sm:px-3.5 py-1.5 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-xs transition-colors whitespace-nowrap\"\n        >\n          <span className=\"hidden sm:inline\">+ New Issue</span>\n          <span className=\"sm:hidden\">+ Issue</span>\n        </button>\n\n        {/* Interactive User Profile & Authentication Dropdown */}\n        <div className=\"relative\" ref={userMenuRef}>\n          <button\n            type=\"button\"\n            onClick={() => setIsUserMenuOpen(!isUserMenuOpen)}\n            className=\"flex items-center gap-2 pl-2 sm:pl-3 border-l border-slate-200 hover:opacity-90 transition-opacity cursor-pointer group\"\n            title=\"User Profile and Authentication Menu\"\n          >\n            <div className=\"w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs ring-2 ring-slate-100 shadow-2xs group-hover:ring-blue-500 transition-all\">\n              {initials}\n            </div>\n            <div className=\"hidden xl:block text-left\">\n              <div className=\"text-xs font-semibold text-slate-900 leading-tight flex items-center gap-1\">\n                <span>{displayName}</span>\n                <ChevronDown className=\"w-3 h-3 text-slate-400 group-hover:text-slate-600\" />\n              </div>\n              <div className=\"text-[10px] text-slate-500 font-mono truncate max-w-[140px]\">\n                {displayEmail}\n              </div>\n            </div>\n          </button>\n\n          {/* User Profile Dropdown Menu */}"
