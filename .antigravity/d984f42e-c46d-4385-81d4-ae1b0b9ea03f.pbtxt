    replacement_infos {
      original_chunk {
        target_content: "        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">\n            {dashboardRole === \'pm\' && \'Project Manager Executive Overview\'}\n            {dashboardRole === \'member\' && `Team Member Dashboard: ${activeMember?.name || \'Engineer\'}`}\n            {dashboardRole === \'admin\' && \'Organization Health & System Diagnostics\'}\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            {dashboardRole === \'pm\' && \'Real-time delivery health, team workloads, and rule-based risk evaluation.\'}\n            {dashboardRole === \'member\' && \'Personal deliverable assignments, upcoming milestone deadlines, and completion velocity.\'}\n            {dashboardRole === \'admin\' && \'Cross-project capacity matrix, workload heatmaps, and enterprise delivery metrics.\'}\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto flex-wrap\">\n          {/* Persona View Switcher */}\n          <div className=\"inline-flex bg-slate-100 p-1 rounded-lg border border-slate-200 text-xs font-semibold\">\n            <button\n              type=\"button\"\n              onClick={() => setDashboardRole(\'pm\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                dashboardRole === \'pm\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              PM View\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setDashboardRole(\'member\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                dashboardRole === \'member\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              My Work\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setDashboardRole(\'admin\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                dashboardRole === \'admin\' ? \'bg-white text-slate-900 shadow-2xs\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Admin View\n            </button>\n          </div>"
        replacement_content: "        <div>\n          <h1 className=\"text-xl sm:text-2xl font-bold text-slate-900 tracking-tight\">\n            {dashboardRole === \'leader\' && \'Team Leader Executive & Governance Dashboard\'}\n            {dashboardRole === \'member\' && `Team Member Dashboard: ${activeMember?.name || \'Engineer\'}`}\n          </h1>\n          <p className=\"text-xs sm:text-sm text-slate-500 mt-0.5\">\n            {dashboardRole === \'leader\' && \'Unified delivery health, member workload distribution, rule-based risk evaluation, and system diagnostics.\'}\n            {dashboardRole === \'member\' && \'Personal deliverable assignments, upcoming milestone deadlines, and completion velocity.\'}\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-2 self-start sm:self-auto flex-wrap\">\n          {/* Persona View Switcher */}\n          <div className=\"inline-flex bg-slate-100 p-1 rounded-lg border border-slate-200 text-xs font-semibold\">\n            <button\n              type=\"button\"\n              onClick={() => setDashboardRole(\'leader\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                dashboardRole === \'leader\' ? \'bg-white text-slate-900 shadow-2xs font-bold\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              Team Leader View\n            </button>\n            <button\n              type=\"button\"\n              onClick={() => setDashboardRole(\'member\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                dashboardRole === \'member\' ? \'bg-white text-slate-900 shadow-2xs font-bold\' : \'text-slate-600 hover:text-slate-900\'\n              }`}\n            >\n              My Work (Member)\n            </button>\n          </div>"
        start_line: 86
