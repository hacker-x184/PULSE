    content: "import React, { useState, useRef, useEffect } from \'react\';\nimport {\n  Menu,\n  Sparkles,\n  Folder,\n  ChevronDown,\n  User as UserIcon,\n  LogIn,\n  UserPlus,\n  LogOut,\n  ShieldCheck,\n  Github,\n  Crown,\n  Bell,\n  Calendar,\n  CheckCircle2,\n  AlertTriangle,\n  FileCode,\n  Check,\n  X\n} from \'lucide-react\';\nimport { Project, User, AppNotification } from \'../../types\';\nimport { api } from \'../../api/client\';\n\ninterface TopBarProps {\n  projects: Project[];\n  selectedProjectId: string;\n  onSelectProject: (id: string) => void;\n  onOpenMobileMenu: () => void;\n  onOpenAI: () => void;\n  onCreateTask: () => void;\n  currentUser: User | null;\n  onOpenAuth: (mode?: \'login\' | \'register\') => void;\n  onLogout: () => void;\n  onOpenGitHub?: () => void;\n  onOpenLeaderModal?: () => void;\n}\n\nexport const TopBar: React.FC<TopBarProps> = ({\n  projects,\n  selectedProjectId,\n  onSelectProject,\n  onOpenMobileMenu,\n  onOpenAI,\n  onCreateTask,\n  currentUser,\n  onOpenAuth,\n  onLogout,\n  onOpenGitHub,\n  onOpenLeaderModal\n}) => {\n  const [isUserMenuOpen, setIsUserMenuOpen] = useState(false);\n  const [isNotifOpen, setIsNotifOpen] = useState(false);\n  const [notifications, setNotifications] = useState<AppNotification[]>([]);\n  const userMenuRef = useRef<HTMLDivElement>(null);\n  const notifMenuRef = useRef<HTMLDivElement>(null);\n\n  const currentProject = projects.find(p => p.id === selectedProjectId);\n\n  // Load in-app notifications\n  useEffect(() => {\n    api.getNotifications()\n      .then(res => setNotifications(res))\n      .catch(() => {});\n  }, [selectedProjectId]);\n\n  // Close dropdowns when clicking outside\n  useEffect(() => {\n    function handleClickOutside(event: MouseEvent) {\n      if (userMenuRef.current && !userMenuRef.current.contains(event.target as Node)) {\n        setIsUserMenuOpen(false);\n      }\n      if (notifMenuRef.current && !notifMenuRef.current.contains(event.target as Node)) {\n        setIsNotifOpen(false);\n      }\n    }\n    document.addEventListener(\'mousedown\', handleClickOutside);\n    return () => document.removeEventListener(\'mousedown\', handleClickOutside);\n  }, []);\n\n  const handleMarkNotifRead = async (id: string) => {\n    try {\n      await api.markNotificationRead(id);\n      setNotifications(prev => prev.map(n => n.id === id ? { ...n, is_read: true } : n));\n    } catch {}\n  };\n\n  const handleClearAllNotifs = async () => {\n    try {\n      await api.clearNotifications();\n      setNotifications(prev => prev.map(n => ({ ...n, is_read: true })));\n    } catch {}\n  };\n\n  const unreadCount = notifications.filter(n => !n.is_read).length;\n\n  const displayName = currentUser?.name || \'Zaid Tested\';\n  const displayEmail = currentUser?.email || \'zaidtested@gmail.com\';\n  const displayRole = currentUser?.role || \'Project Director\';\n  const initials = displayName"
