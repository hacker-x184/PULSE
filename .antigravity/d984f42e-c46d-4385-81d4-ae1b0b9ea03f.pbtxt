              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "{`-- Deterministic Contributor Scoring Ledger"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "CREATE TABLE member_contributions ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  id TEXT PRIMARY KEY,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  member_id TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  project_id TEXT NOT NULL,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  visible_commits_score REAL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  code_reviews_score REAL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  mentoring_kudos_score REAL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  backlog_velocity_score REAL DEFAULT 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  composite_fair_score REAL GENERATED ALWAYS AS ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (visible_commits_score * 0.35) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (code_reviews_score * 0.25) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (mentoring_kudos_score * 0.20) +"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (backlog_velocity_score * 0.20)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ) STORED"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: ");`}"
