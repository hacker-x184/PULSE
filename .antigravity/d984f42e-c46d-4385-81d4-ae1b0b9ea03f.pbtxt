    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "      if (mode === \'login\') {\n        const res = await api.login({ email, password });\n        setSuccessMessage(`Welcome back, ${res.user.name}!`);\n        setTimeout(() => {\n          onAuthSuccess(res.user);\n          onClose();\n          resetForm();\n        }, 500);\n      } else {\n        if (!name.trim()) {\n          setErrorMessage(\'Full name is required\');\n          setIsLoading(false);\n          return;\n        }\n        const res = await api.register({\n          name: name.trim(),\n          email: email.trim(),\n          password,\n          role\n        });\n        setSuccessMessage(`Account created successfully! Logged in as ${res.user.name}`);\n        setTimeout(() => {\n          onAuthSuccess(res.user);\n          onClose();\n          resetForm();\n        }, 600);\n      }\n    } catch (err: any) {\n      setErrorMessage(err.message || \'Authentication failed. Please verify credentials.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={() => {\n        onClose();\n        resetForm();\n      }}\n      title={mode === \'login\' ? \'Platform Authentication\' : \'Create Enterprise Account\'}\n      subtitle={\n        mode === \'login\'\n          ? \'Sign in to access your assigned deliverables, projects, and risk metrics.\'\n          : \'Register a new team workspace identity with SQLite persistence.\'\n      }\n    >\n      <div className=\"space-y-4\">\n        {/* Tab switchers */}\n        <div className=\"flex border-b border-slate-200\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\'login\');\n              setErrorMessage(null);\n            }}\n            className={`pb-2.5 px-4 text-xs font-semibold border-b-2 transition-colors ${\n              mode === \'login\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Sign In\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\'register\');\n              setErrorMessage(null);\n            }}\n            className={`pb-2.5 px-4 text-xs font-semibold border-b-2 transition-colors ${\n              mode === \'register\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Create New Account\n          </button>\n        </div>"
        replacement_content: "      if (mode === \'login\') {\n        const res = await api.login({ email, password });\n        setSuccessMessage(`Welcome back, ${res.user.name}!`);\n        setTimeout(() => {\n          onAuthSuccess(res.user);\n          onClose();\n          resetForm();\n        }, 500);\n      } else if (mode === \'register\') {\n        if (!name.trim()) {\n          setErrorMessage(\'Full name is required\');\n          setIsLoading(false);\n          return;\n        }\n        const res = await api.register({\n          name: name.trim(),\n          email: email.trim(),\n          password,\n          role\n        });\n        setSuccessMessage(`Account created successfully! Logged in as ${res.user.name}`);\n        setTimeout(() => {\n          onAuthSuccess(res.user);\n          onClose();\n          resetForm();\n        }, 600);\n      } else {\n        await api.resetPassword(email.trim(), password);\n        setSuccessMessage(\'Password updated successfully! Please sign in with your new credentials.\');\n        setTimeout(() => {\n          setMode(\'login\');\n          setPassword(\'\');\n          setErrorMessage(null);\n        }, 1500);\n      }\n    } catch (err: any) {\n      setErrorMessage(err.message || \'Operation failed. Please verify credentials.\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <Modal\n      isOpen={isOpen}\n      onClose={() => {\n        onClose();\n        resetForm();\n      }}\n      title={\n        mode === \'login\'\n          ? \'Platform Authentication\'\n          : mode === \'register\'\n          ? \'Create Enterprise Account\'\n          : \'Reset Account Password\'\n      }\n      subtitle={\n        mode === \'login\'\n          ? \'Sign in to access your assigned deliverables, projects, and risk metrics.\'\n          : mode === \'register\'\n          ? \'Register a new team workspace identity with SQLite persistence.\'\n          : \'Set a new password for your registered corporate account.\'\n      }\n    >\n      <div className=\"space-y-4\">\n        {/* Tab switchers */}\n        <div className=\"flex border-b border-slate-200\">\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\'login\');\n              setErrorMessage(null);\n            }}\n            className={`pb-2.5 px-3 sm:px-4 text-xs font-semibold border-b-2 transition-colors ${\n              mode === \'login\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Sign In\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\'register\');\n              setErrorMessage(null);\n            }}\n            className={`pb-2.5 px-3 sm:px-4 text-xs font-semibold border-b-2 transition-colors ${\n              mode === \'register\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Register\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => {\n              setMode(\'reset\');\n              setErrorMessage(null);\n            }}\n            className={`pb-2.5 px-3 sm:px-4 text-xs font-semibold border-b-2 transition-colors ${\n              mode === \'reset\'\n                ? \'border-blue-600 text-blue-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-800\'\n            }`}\n          >\n            Reset Password\n          </button>\n        </div>"
