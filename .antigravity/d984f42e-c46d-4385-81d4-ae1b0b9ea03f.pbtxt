              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      <Modal"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        isOpen={isMethodologyOpen}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        onClose={() => setIsMethodologyOpen(false)}"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        title=\"Contribution Calculation Methodology\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        subtitle=\"Mathematical formulation and auditing transparency\""
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      >"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        <div className=\"space-y-4 text-xs text-slate-700 leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <h4 className=\"font-bold text-slate-900 mb-1\">1. Completion Rate Formula</h4>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <div className=\"font-mono text-blue-700 bg-white p-2 rounded border border-slate-200 mb-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              Completion Rate = (Completed Tasks / Total Assigned Tasks) \303\227 100%"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <p className=\"text-slate-500\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              Evaluates raw milestone completion regardless of task complexity. If zero tasks are assigned, the rate is cleanly recorded as 0%."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <h4 className=\"font-bold text-slate-900 mb-1\">2. Priority-Weighted Score Formula</h4>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <div className=\"font-mono text-blue-700 bg-white p-2 rounded border border-slate-200 mb-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              Weighted Score = (\316\243 Completed Priority Weights / \316\243 Total Assigned Weights) \303\227 100%"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <p className=\"text-slate-500\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "              High priority tasks are weighted at 3x, Medium priority at 2x, and Low priority at 1x. This accurately credits members handling high-impact, critical architecture deliverables."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            </p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          <div className=\"p-3 bg-slate-50 rounded-lg border border-slate-200\">"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            <h4 className=\"font-bold text-slate-900 mb-1\">3. Handling Missing Integrations</h4>"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            <h4 className=\"font-bold text-slate-900 mb-1\">3. Recognition of Invisible Work</h4>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <p className=\"text-slate-500\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              Disputes can be logged for mentoring, architecture design, and undocumented code reviews. Approved claims add verified percentage adjustments directly to the weighted score."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
